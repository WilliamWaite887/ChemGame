// Reactions. Reactant and product amounts are *ratios*, not fixed quantities:
// a 1:1:1 recipe producing 3 turns 15u of each input into 45u of output.
//
// `priority` decides who wins when two reactions compete for the same reagent.
// The policy here: compound recipes (20) outrank the base recipes that feed
// them (10), and kelotane sits lowest (5) because it competes with both
// inaprovaline and dylovene for carbon and silicon — without that, dumping a
// tricordrazine mix into one beaker would have kelotane eat the ingredients.
//
// `hints` are revealed progressively in the reference book while a recipe is
// still locked, coarsest first. Ingredient *count* is derived automatically,
// so hints should add something beyond it.
//
// `process` controls how a recipe is allowed to begin. Omitted means Ambient:
// ingredients react whenever they share a solution. Agitated recipes declare
// two preparation sides. Both sides must be present in separate beakers before
// the Mixing Chamber combines them; pouring everything into one beaker cannot
// start them.
//
// `rate` is reaction-units per second. Omitted, an ambient recipe is
// instantaneous: it finishes inside the pour that made it possible, exactly as
// all of them once did. Given a rate, the same recipe takes real seconds — you
// can watch it, carry it, be interrupted during it, or pull it out of the
// chamber halfway.
// `scale` is the multiplier the recipe runs at, so a 1:1 recipe producing 2
// needs a scale of 10 to make 20u of product: at `rate: 5` that is two seconds.
//
// Which recipes have one, and why:
//
//   * The three base recipes stay instant. They are the tutorial, and the
//     first thing a new chemist does should not be waiting.
//   * Everything one or two steps up is rated. That is what the counter
//     actually orders, so it is where a batch taking time is felt.
//   * **Nothing with a `Heat` effect is rated**, and this is deliberate rather
//     than an omission. Phlogiston and chlorine trifluoride are tuned to the
//     kelvin against the resolver running a whole batch in one pass (see their
//     own comments below): heat released over four seconds is heat the reaction
//     chamber's own 18%-of-the-gap-per-second is pulling straight back out
//     again, which quietly moves the batch size at which they detonate. Rating
//     them is a *good* idea — "watch it climb and decide whether to pull it
//     out" is the best version of that mechanic — but it needs both their
//     tuning blocks rebuilt against thermal exchange, and that is a balance
//     pass, not a data edit.
[
    // ---- Base recipes: the three the player starts knowing -----------------
    (
        id: "inaprovaline",
        reactants: [("oxygen", 1), ("carbon", 1), ("sugar", 1)],
        products: [("inaprovaline", 3)],
        priority: 10,
        hints: [
            "Equal parts of three base reagents.",
            "One of them is what you would put in a cup of tea.",
        ],
    ),
    (
        id: "dylovene",
        reactants: [("silicon", 1), ("nitrogen", 1), ("potassium", 1)],
        products: [("dylovene", 3)],
        priority: 10,
        hints: [
            "Equal parts of three base reagents, none of them organic.",
            "Silicon is involved.",
        ],
    ),
    (
        id: "kelotane",
        reactants: [("silicon", 1), ("carbon", 1)],
        products: [("kelotane", 2)],
        priority: 5,
        hints: [
            "Two base reagents, equal parts.",
            "Both are solids. One of them is carbon.",
        ],
    ),

    // ---- One step up ------------------------------------------------------
    (
        id: "bicaridine",
        reactants: [("inaprovaline", 1), ("carbon", 1)],
        products: [("bicaridine", 2)],
        process: Agitated(
            side_a: [("inaprovaline", 1)],
            side_b: [("carbon", 1)],
        ),
        // The ordered 8–14u range takes 4–7 seconds.
        rate: Some(1),
        priority: 20,
        hints: [
            "One ingredient is a compound you already know how to make.",
            "The other is a single base reagent.",
            "Add carbon to inaprovaline.",
        ],
    ),
    (
        id: "hyronalin",
        reactants: [("dylovene", 1), ("radium", 1)],
        products: [("hyronalin", 2)],
        process: Agitated(
            side_a: [("dylovene", 1)],
            side_b: [("radium", 1)],
        ),
        // The ordered 20–30u range takes 5–7.5 seconds.
        rate: Some(2),
        priority: 15,
        hints: [
            "One ingredient is a compound you already know how to make.",
            "The other is radioactive.",
            "Add radium to dylovene.",
        ],
    ),
    (
        id: "tricordrazine",
        reactants: [("inaprovaline", 1), ("dylovene", 1)],
        products: [("tricordrazine", 2)],
        process: Agitated(
            side_a: [("inaprovaline", 1)],
            side_b: [("dylovene", 1)],
        ),
        // The ordered 30–40u range takes 5–6.67 seconds.
        rate: Some(3),
        priority: 20,
        hints: [
            "No base reagents at all.",
            "Both ingredients are compounds you already know how to make.",
            "Equal parts inaprovaline and dylovene.",
        ],
    ),
    (
        id: "dermaline",
        reactants: [("kelotane", 1), ("oxygen", 1), ("phosphorus", 1)],
        products: [("dermaline", 3)],
        process: Agitated(
            side_a: [("kelotane", 1)],
            side_b: [("oxygen", 1), ("phosphorus", 1)],
        ),
        // The ordered 6–9u range takes 4–6 seconds.
        rate: Some(0.5),
        priority: 20,
        hints: [
            "Three ingredients: one compound and two base reagents.",
            "Start from the weaker burn treatment.",
            "Equal parts kelotane, oxygen and phosphorus.",
        ],
    ),

    // ---- Two steps up -----------------------------------------------------
    (
        id: "arithrazine",
        reactants: [("hyronalin", 1), ("hydrogen", 1)],
        products: [("arithrazine", 2)],
        process: Agitated(
            side_a: [("hyronalin", 1)],
            side_b: [("hydrogen", 1)],
        ),
        // Its second agitation takes 5–7.5 seconds for a 20–30u order.
        rate: Some(2),
        priority: 20,
        hints: [
            "Two ingredients. One is a compound two steps removed from base reagents.",
            "Strengthen the milder radiation treatment.",
            "Equal parts hyronalin and hydrogen.",
        ],
    ),

    // ---- Catalysed --------------------------------------------------------
    (
        // Plasma is a catalyst: it must be present but is not consumed, and it
        // does not limit the yield. A single unit will catalyse a whole beaker.
        id: "dexalin",
        reactants: [("oxygen", 2)],
        catalysts: [("plasma", 1)],
        products: [("dexalin", 1)],
        process: Agitated(
            side_a: [("oxygen", 2)],
            side_b: [("plasma", 1)],
        ),
        // Higher because this recipe loses volume. The ordered 12–20u range
        // takes 4–6.67 seconds while the catalyst survives.
        rate: Some(3),
        priority: 12,
        hints: [
            "Only one ingredient is consumed, and you get back half what you put in.",
            "Something else has to be present to make it happen, but survives untouched.",
            "Oxygen, with plasma as a catalyst.",
        ],
    ),

    // ---- Toxins -----------------------------------------------------------
    //
    // Nobody ever orders these — `station.orders.ron` does not list them — but
    // they sit in the book as locked entries, and finding one by accident is
    // the point. Priority 8 keeps them below the medicine chain so a beaker
    // meant for inaprovaline does not turn into acid.
    (
        id: "sulphuric_acid",
        reactants: [("sulfur", 1), ("hydrogen", 1), ("oxygen", 2)],
        products: [("sulphuric_acid", 3)],
        priority: 8,
        hints: [
            "Three base reagents, one of them at double.",
            "Starts with the yellow one nobody has found a use for.",
            "Sulfur and hydrogen, with twice as much oxygen.",
        ],
    ),
    (
        id: "chloral_hydrate",
        reactants: [("chlorine", 3), ("ethanol", 1), ("water", 1)],
        products: [("chloral_hydrate", 1)],
        priority: 8,
        hints: [
            "Three base reagents in unequal parts, and you get very little back.",
            "Mostly chlorine.",
            "Three parts chlorine to one each of ethanol and water.",
        ],
    ),
    (
        // The showpiece, and the reason the reaction chamber exists.
        //
        // It will not start below 374K, it heats itself as it runs, and past
        // 420K it detonates. Left alone in a chamber dialled too high it will
        // cook itself into a blast without any further help from the chemist —
        // which is exactly the SS13 experience being recreated.
        id: "phlogiston",
        reactants: [("plasma", 1), ("sulphuric_acid", 1), ("phosphorus", 1)],
        products: [("phlogiston", 3)],
        min_temp: Some((374.0)),
        overheat_temp: Some((420.0)),
        overheat: Detonate(power: 3.0),
        // 2.5K per unit of reaction, and the resolver runs the whole batch in
        // one pass — so the heat released scales with how much you made. That
        // is what turns batch size into the decision:
        //
        //   50u beaker, at most 16u of each  ->  ~416K, safe at any fill
        //   100u beaker, under 19u of each   ->  under 420K, safe
        //   100u beaker, 20u of each or more ->  past 420K, detonates
        //
        // Tuned deliberately. At the original 1.2 a full large beaker peaked at
        // 414K and the reaction could never detonate at all, which made the
        // overheat rule dead data.
        effects: [Heat(2.5)],
        priority: 25,
        hints: [
            "Will not start at room temperature.",
            "Three ingredients, one of them a compound. It gives off heat as it runs.",
            "Plasma, phosphorus and sulphuric acid, held above 374K.",
        ],
    ),

    // ---- Stimulants -------------------------------------------------------
    (
        id: "hyperzine",
        reactants: [("sugar", 1), ("phosphorus", 1), ("sulfur", 1)],
        products: [("hyperzine", 3)],
        priority: 8,
        hints: [
            "Three base reagents, equal parts.",
            "One of them is the sweet one.",
            "Sugar, phosphorus and sulfur.",
        ],
    ),
    (
        id: "synaptizine",
        reactants: [("lithium", 1), ("sugar", 1), ("water", 1)],
        products: [("synaptizine", 3)],
        priority: 8,
        hints: [
            "Three base reagents, equal parts. One of them is a metal.",
            "Lithium is involved, which on its own makes you unsteady.",
            "Lithium, sugar and water.",
        ],
    ),

    // ---- Drink ------------------------------------------------------------
    (
        // Smokes when it comes together, which is the only reaction in the game
        // that vents into the room. A cheap way to learn what a cloud does
        // before phlogiston teaches you what a blast does.
        id: "hooch",
        reactants: [("ethanol", 3), ("sugar", 1), ("water", 1)],
        products: [("hooch", 5)],
        effects: [Smoke(2.2)],
        priority: 8,
        hints: [
            "Three base reagents. Mostly the one you should not be drinking.",
            "It fumes when it comes together — stand back.",
            "Three parts ethanol to one each of sugar and water.",
        ],
    ),

    // ---- Precursors -------------------------------------------------------
    //
    // The industrial tier from /tg/station's guide. Priority 10 puts them level
    // with the base medicines and below the compounds, so a beaker being built
    // up toward tricordrazine never loses its water to saltwater on the way.
    (
        id: "ammonia",
        reactants: [("hydrogen", 3), ("nitrogen", 1)],
        products: [("ammonia", 3)],
        priority: 10,
        hints: [
            "Two base gases in unequal parts, and you get back less than you put in.",
            "Three parts of the lightest thing in the lab.",
            "Three parts hydrogen to one of nitrogen.",
        ],
    ),
    (
        id: "sodium_chloride",
        reactants: [("sodium", 1), ("chlorine", 1)],
        products: [("sodium_chloride", 2)],
        priority: 10,
        hints: [
            "Two base reagents, equal parts. You already know what it makes.",
            "One of them has never been used for anything else.",
            "Sodium and chlorine.",
        ],
    ),
    (
        id: "saltwater",
        reactants: [("sodium_chloride", 1), ("water", 1)],
        products: [("saltwater", 2)],
        priority: 10,
        hints: [
            "One compound and one base reagent, and the answer is in the name.",
            "Dissolve the salt.",
            "Equal parts table salt and water.",
        ],
    ),
    (
        // The first recipe in the game that needs the chamber turned *down*.
        // Every temperature-gated recipe before this one wanted heat, which
        // left the 273K preset doing nothing at all.
        //
        // No melting reaction on the way back: its product would be water, and
        // the book names entries after what they make, so it would appear as a
        // recipe called "Water". Ice made is ice kept.
        id: "ice",
        reactants: [("water", 1)],
        products: [("ice", 1)],
        max_temp: Some((273.0)),
        priority: 10,
        hints: [
            "One ingredient, and no amount of mixing will do it.",
            "The chamber dial goes down as well as up.",
            "Water, held below 273K.",
        ],
    ),
    (
        id: "stabilizing_agent",
        reactants: [("iron", 1), ("oxygen", 1), ("hydrogen", 1)],
        products: [("stabilizing_agent", 3)],
        priority: 10,
        hints: [
            "Three base reagents, equal parts, and it treats nothing.",
            "Built on the one metal that helps rather than harms.",
            "Equal parts iron, oxygen and hydrogen.",
        ],
    ),
    (
        id: "oil",
        reactants: [("welding_fuel", 1), ("carbon", 1), ("hydrogen", 1)],
        products: [("oil", 3)],
        priority: 10,
        hints: [
            "Three base reagents, equal parts. Nobody drinks the first one.",
            "Thicken the welding fuel.",
            "Equal parts welding fuel, carbon and hydrogen.",
        ],
    ),
    (
        id: "hydrogen_peroxide",
        reactants: [("chlorine", 1), ("oxygen", 1), ("water", 1)],
        products: [("hydrogen_peroxide", 3)],
        priority: 8,
        hints: [
            "Three base reagents, equal parts. It bleaches what it lands on.",
            "Water and oxygen, with something that stings.",
            "Equal parts chlorine, oxygen and water.",
        ],
    ),

    // ---- New medicines ----------------------------------------------------
    (
        id: "potassium_iodide",
        reactants: [("potassium", 1), ("iodine", 1)],
        products: [("potassium_iodide", 2)],
        process: Agitated(
            side_a: [("potassium", 1)],
            side_b: [("iodine", 1)],
        ),
        // The ordered 20–30u range takes 4–6 seconds.
        rate: Some(2.5),
        priority: 20,
        hints: [
            "Two base reagents, equal parts, and the name gives both away.",
            "For radiation, but taken before rather than after.",
            "Equal parts potassium and iodine.",
        ],
    ),
    (
        id: "mannitol",
        reactants: [("hydrogen", 2), ("water", 2), ("sugar", 2)],
        products: [("mannitol", 3)],
        process: Agitated(
            side_a: [("hydrogen", 2), ("water", 2)],
            side_b: [("sugar", 2)],
        ),
        // The ordered 10–15u range takes 4.17–6.25 seconds.
        rate: Some(0.8),
        priority: 20,
        hints: [
            "Three base reagents in equal parts, and you get back half.",
            "Sugar water, with something lighter than air.",
            "Equal parts hydrogen, water and sugar.",
        ],
    ),
    (
        id: "saline_glucose",
        reactants: [("saltwater", 2), ("water", 1), ("sugar", 1)],
        products: [("saline_glucose", 4)],
        process: Agitated(
            side_a: [("saltwater", 2), ("water", 1)],
            side_b: [("sugar", 1)],
        ),
        // The ordered 40–50u range takes 5–6.25 seconds.
        rate: Some(2),
        priority: 20,
        hints: [
            "One compound and two base reagents, and the compound is doubled.",
            "Salt water and sugar water, in the same bag.",
            "Two parts saltwater to one each of water and sugar.",
        ],
    ),

    // ---- Pyrotechnics -----------------------------------------------------
    //
    // Priority 6-8 so a mixed beaker never turns into one of these by accident.
    // The exception is chlorine trifluoride, which is gated behind 424K and so
    // can only ever be made on purpose.
    (
        id: "thermite",
        reactants: [("aluminium", 1), ("iron", 1), ("oxygen", 1)],
        products: [("thermite", 3)],
        priority: 8,
        hints: [
            "Three base reagents, equal parts. Two of them are metals.",
            "The metal nothing else in the book has ever wanted.",
            "Equal parts aluminium, iron and oxygen.",
        ],
    ),
    (
        id: "flash_powder",
        reactants: [("aluminium", 1), ("potassium", 1), ("sulfur", 1)],
        products: [("flash_powder", 3)],
        priority: 8,
        hints: [
            "Three base reagents, equal parts; release the powder to trigger its flash.",
            "Aluminium again, with the yellow one.",
            "Equal parts aluminium, potassium and sulfur.",
        ],
    ),
    (
        // Paired deliberately with `smoke_powder` below: identical reactants,
        // and a single unit of stabilizing agent decides which one you get.
        // Priority 6 loses to the stabilised version at 14 whenever the
        // catalyst is present, which is the entire lesson.
        id: "smoke",
        reactants: [("phosphorus", 1), ("potassium", 1), ("sugar", 1)],
        products: [("smoke", 3)],
        effects: [Smoke(3.0)],
        priority: 6,
        hints: [
            "Three base reagents, equal parts. You will know when it works.",
            "It vents into the room the moment it comes together.",
            "Equal parts phosphorus, potassium and sugar.",
        ],
    ),
    (
        id: "smoke_powder",
        reactants: [("phosphorus", 1), ("potassium", 1), ("sugar", 1)],
        catalysts: [("stabilizing_agent", 1)],
        products: [("smoke_powder", 3)],
        priority: 14,
        hints: [
            "The same three reagents as something you may already have made.",
            "One more thing in the beaker, and the cloud stays in the beaker.",
            "Phosphorus, potassium and sugar, over stabilizing agent.",
        ],
    ),
    (
        id: "chlorine_trifluoride",
        reactants: [("fluorine", 3), ("chlorine", 1)],
        products: [("chlorine_trifluoride", 3)],
        min_temp: Some((424.0)),
        overheat_temp: Some((500.0)),
        overheat: Detonate(power: 4.0),
        // Hotter per unit than phlogiston, and with a narrower window: 424K to
        // start, 500K to detonate. Reactants are a 3:1 ratio (not
        // phlogiston's 1:1:1), so `scale` is chlorine's share:
        //
        //   50u beaker, at most 12-of-ratio  ->  ~472K, safe at any fill
        //   100u beaker, under 20-of-ratio    ->  under 500K, safe
        //   100u beaker, 20-of-ratio or more  ->  past 500K, detonates
        //
        // Tuned deliberately. At the original 3.0 a full 100u beaker
        // (25-of-ratio) peaked at 499.5K — 0.5K short of 500K — which made
        // the overheat rule dead data exactly the way phlogiston's original
        // 1.2 did, just close enough to the line that it went unnoticed.
        effects: [Heat(4.0)],
        priority: 25,
        hints: [
            "Two base reagents, and the chamber has to be very hot indeed.",
            "Three parts of one halogen to one of another. It heats itself.",
            "Three parts fluorine to one of chlorine, above 424K.",
        ],
    ),
    (
        // The only endothermic reaction in the game. `Heat` is plain addition
        // in the resolver, so a negative value cools the beaker — a batch of
        // this ends up colder than the room it was made in.
        id: "cryostylane",
        reactants: [("ice", 1), ("plasma", 1), ("nitrogen", 1)],
        products: [("cryostylane", 3)],
        effects: [Heat(-1.5)],
        priority: 8,
        hints: [
            "One compound and two base reagents. The compound is not a liquid.",
            "It takes heat out of the beaker rather than putting it in.",
            "Equal parts ice, plasma and nitrogen.",
        ],
    ),
    (
        id: "napalm",
        reactants: [("oil", 1), ("welding_fuel", 1), ("ethanol", 1)],
        products: [("napalm", 3)],
        priority: 8,
        hints: [
            "One compound and two base reagents, all three of them flammable.",
            "Thickened welding fuel, and then more welding fuel.",
            "Equal parts oil, welding fuel and ethanol.",
        ],
    ),

    // ---- More toxins ------------------------------------------------------
    (
        id: "unstable_mutagen",
        reactants: [("chlorine", 1), ("phosphorus", 1), ("radium", 1)],
        products: [("unstable_mutagen", 3)],
        priority: 8,
        hints: [
            "Three base reagents, equal parts, one of them radioactive.",
            "Radium, and two things that were never meant to meet it.",
            "Equal parts chlorine, phosphorus and radium.",
        ],
    ),
    (
        id: "cyanide",
        reactants: [("oil", 1), ("ammonia", 1), ("oxygen", 1)],
        products: [("cyanide", 3)],
        min_temp: Some((380.0)),
        priority: 8,
        hints: [
            "Two compounds and a base reagent, and the chamber has to be hot.",
            "Both compounds are things you made for something else.",
            "Equal parts oil, ammonia and oxygen, above 380K.",
        ],
    ),

    // ---- Utility ----------------------------------------------------------
    (
        id: "space_cleaner",
        reactants: [("ammonia", 1), ("water", 1)],
        products: [("space_cleaner", 2)],
        priority: 8,
        hints: [
            "One compound and one base reagent. It is not medicine.",
            "Dilute the fertiliser.",
            "Equal parts ammonia and water.",
        ],
    ),

    // ---- Illicit --------------------------------------------------------
    //
    // Never listed in `station.orders.ron` — only the hidden pool in
    // `station.antagonist.ron` asks for these. Reachable and hinted exactly
    // like every other locked recipe; finding one by accident is the point.
    (
        id: "space_drugs",
        reactants: [("lithium", 1), ("mercury", 1), ("sugar", 1)],
        products: [("space_drugs", 3)],
        priority: 8,
        hints: [
            "Three base reagents, none of them anything a chemist reaches for on purpose.",
            "A metal that unsteadies, a metal that poisons, and sugar.",
            "Equal parts lithium, mercury and sugar.",
        ],
    ),
    (
        id: "bath_salts",
        reactants: [("space_drugs", 1), ("sodium", 1), ("sulfur", 1)],
        products: [("bath_salts", 3)],
        priority: 8,
        hints: [
            "One compound and two base reagents, and the compound is not medicine.",
            "Cut what space drugs make with sodium and sulfur.",
            "Equal parts space drugs, sodium and sulfur.",
        ],
    ),
    (
        id: "krokodil",
        reactants: [("oil", 1), ("iodine", 1), ("phosphorus", 1)],
        products: [("krokodil", 3)],
        priority: 8,
        hints: [
            "One compound and two base reagents. The compound is thickened welding fuel.",
            "Oil, cut with iodine and phosphorus.",
            "Equal parts oil, iodine and phosphorus.",
        ],
    ),
    (
        id: "methamphetamine",
        reactants: [("ammonia", 1), ("iodine", 1), ("phosphorus", 1)],
        products: [("methamphetamine", 3)],
        min_temp: Some((374.0)),
        priority: 8,
        hints: [
            "One compound and two base reagents, and the chamber has to run hot.",
            "Ammonia, cut with iodine and phosphorus, above 374K.",
            "Equal parts ammonia, iodine and phosphorus, above 374K.",
        ],
    ),
    (
        id: "mindbreaker_toxin",
        reactants: [("silicon", 1), ("hydrogen", 1), ("sulfur", 1)],
        products: [("mindbreaker_toxin", 3)],
        priority: 8,
        hints: [
            "Three base reagents, equal parts.",
            "The one that etches glass, the lightest gas, and the yellow one.",
            "Equal parts silicon, hydrogen and sulfur.",
        ],
    ),
    (
        id: "zombie_powder",
        reactants: [("radium", 1), ("potassium", 1), ("mercury", 1)],
        products: [("zombie_powder", 3)],
        priority: 8,
        hints: [
            "Three base reagents, equal parts, two of them dangerous alone.",
            "Radium and mercury, cut with potassium.",
            "Equal parts radium, potassium and mercury.",
        ],
    ),

    // ---- Dangerous chemistry progression --------------------------------
    (
        id: "ash", material_only: true, reactants: [("oil", 1)], products: [("ash", 1)],
        min_temp: Some((480.0)), priority: 18,
        hints: ["One industrial precursor, heated nearly to ignition.", "Bake oil above 480K."],
    ),
    (
        id: "saltpetre", reactants: [("oxygen", 3), ("potassium", 1), ("nitrogen", 1)], products: [("saltpetre", 3)],
        priority: 4,
        hints: ["Three base reagents, with the oxidizer tripled.", "Three oxygen to one each potassium and nitrogen."],
    ),
    (
        id: "multiver", reactants: [("sodium_chloride", 2), ("ash", 2)], products: [("multiver", 4)],
        min_temp: Some((380.0)), max_temp: Some((410.0)), min_ph: Some(7.0), optimal_ph: Some(9.0), max_ph: Some(11.0),
        rate: Some(1), priority: 22,
        hints: ["Two precursors in equal amounts within a narrow warm range.", "Salt and ash, held between 380K and 410K."],
    ),
    (
        id: "gunpowder", reactants: [("multiver", 1), ("saltpetre", 1), ("sulfur", 1)], products: [("gunpowder", 3)],
        priority: 20,
        hints: ["An antitoxin, an oxidizer, and sulfur.", "Equal parts multiver, saltpetre, and sulfur."],
    ),
    (
        id: "acetone", reactants: [("oil", 1), ("welding_fuel", 1), ("oxygen", 1)], products: [("acetone", 3)],
        priority: 12,
        hints: ["Three flammable or oxidizing inputs in equal parts.", "Oil, welding fuel, and oxygen."],
    ),
    (
        id: "phenol", reactants: [("oil", 1), ("chlorine", 1), ("water", 1)], products: [("phenol", 3)],
        priority: 12,
