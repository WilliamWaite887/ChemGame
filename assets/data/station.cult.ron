// A ritual, escalating one delivery at a time. One recurring identity, kept
// off station.crew.ron for the same reason obsessed.ron's is. The final
// stage asks for flash_powder — never dispensable on its own, only ever the
// product of mixing aluminium, potassium and sulfur, which fires a real
// Smoke effect the instant the player combines them (see
// chem.reactions.ron's flash_powder entry). The danger is in preparing the
// ritual's own ask, through entirely unmodified chemistry.
(
    name: "Corwin Ashe",
    role: "Cargo",
    color: (0.30, 0.10, 0.14),
    gap_multiplier: (12.0, 20.0),
    stages: [
        (
            reagent: "space_drugs",
            amount: 15,
            pretext: "For the circle. Nothing that isn't already circulating on this station.",
            ritual_line: "Corwin Ashe: The first offering is made. The rest will come easier now.",
            reward_reagent: "tricordrazine",
            reward_amount: 10,
            incidents: [
                (
                    name: "Wet chalk sigil",
                    clue: "MAINT: A dark chalk mark has appeared at the primary maintenance junction. It smears into a caustic film; ordinary water only spreads it.",
                    spot: "cult.wet_chalk_sigil",
                    treatment: "space_cleaner",
                    amount: 10,
                ),
                (
                    name: "Whispering residue",
                    clue: "QUARANTINE: A sweet chemical residue is making the sealed room swim. Someone needs to neutralise it.",
                    spot: "cult.whispering_residue",
                    treatment: "dylovene",
                    amount: 10,
                ),
            ],
        ),
        (
            reagent: "mindbreaker_toxin",
            // Overdoses at 12u.
            amount: 12,
            pretext: "We need clearer sight for what comes next. You understand.",
            ritual_line: "Corwin Ashe: The others are seeing it too, now. Soon there won't be any doubt.",
            reward_reagent: "saline_glucose",
            reward_amount: 15,
            incidents: [
                (
                    name: "Bleeding offering bowl",
                    clue: "CHAPEL: A bowl that was not there a moment ago is overflowing at the altar with something too dark to be blood. It pulses when anyone gets close.",
                    spot: "cult.bleeding_offering_bowl",
                    treatment: "bicaridine",
                    amount: 10,
                ),
                (
                    name: "Scorched invocation",
                    clue: "CHAPEL: The rear floor is blistering hot. The markings are burning outward through the grout toward the public nave.",
                    spot: "cult.scorched_invocation",
                    treatment: "kelotane",
                    amount: 10,
                ),
            ],
        ),
        (
            reagent: "flash_powder",
            amount: 10,
            pretext: "The final component. Bright enough to open the way. You'll want to make this one carefully.",
            ritual_line: "Corwin Ashe: It is done. Whatever happens in maintenance tonight, it isn't our concern anymore.",
            reward_reagent: "inaprovaline",
            reward_amount: 10,
            incidents: [
                (
                    name: "Airless candle",
                    clue: "ATMOS/UTILITY: A candle is burning beside the life-support plant without consuming air. Every breath near it feels thin and shallow.",
                    spot: "cult.airless_candle",
                    treatment: "inaprovaline",
                    amount: 10,
                ),
                (
                    name: "Rift-seal scar",
                    clue: "REAR MAINT: The wall is sweating pale vapour around a cut in reality. The fumes sting the lungs and won't settle.",
                    spot: "cult.rift_seal_scar",
                    treatment: "dylovene",
                    amount: 12,
                ),
            ],
        ),
    ],
)
