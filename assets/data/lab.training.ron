// Goals are verified against committed gameplay state. IDs survive content revisions.
[
(
    id: "bearings",
    title: "Find your bearings",
    core: true,
    stages: [(
    goal: Meet,
    objective: "Talk to the Lab Instructor with {interact}.",
    explanation: "Welcome to the practice lab. Your career is untouched, and every exercise can be restarted.",
    marker: "Talk to Lab Instructor · {interact}",
    focus: "instructor",
    article: "handling",
    hints: ("Walk up to the Lab Instructor, aim at them, and press {interact}.", "Aim at the instructor until their name appears, then press {interact}.", "Stand close enough to see the interaction prompt. Close any open panel first."),
), (
    goal: Pickup,
    objective: "Pick up an empty beaker.",
    explanation: "Start with clean glassware. Only the selected inventory item is held.",
    marker: "Supply bench",
    focus: "supplies",
    article: "handling",
    hints: ("Look at an empty beaker on the supply bench and press {interact}.", "Stand beside the supply bench and aim directly at an empty beaker.", "If your inventory is full, select an unwanted item and press {drop} to make room."),
), (
    goal: Select,
    objective: "Select another hotbar slot.",
    explanation: "The four slots carry items; actions use the selected slot.",
    marker: "Supply bench",
    focus: "supplies",
    article: "handling",
    hints: ("Press 2 to select the second slot, then select the slot holding your beaker.", "Use the number keys 1–4 to change the selected slot.", "Select a slot other than slot 1 to complete this step. Then select your beaker again."),
), (
    goal: Load,
    objective: "Load your beaker into the ChemMaster 5000.",
    explanation: "Machines work on loaded containers. The same use action loads your selected item.",
    marker: "Use ChemMaster 5000 · {interact}",
    focus: "training.chemmaster5000",
    article: "chemmaster5000",
    hints: ("Hold the beaker, approach the ChemMaster 5000, and use {interact}.", "Select the slot with your beaker before pressing {interact} on the ChemMaster 5000.", "If another container is loaded, open the ChemMaster 5000 and eject it first."),
), (
    goal: Retrieve,
    objective: "Retrieve the loaded beaker.",
    explanation: "Use the ChemMaster 5000 again with an empty hand to open its controls, then choose Eject. It returns your glassware to a free inventory slot or drops it nearby if your inventory is full.",
    marker: "Use ChemMaster 5000 · {interact}",
    focus: "training.chemmaster5000",
    article: "handling",
    hints: ("With an empty selected slot, use {interact} on the ChemMaster 5000 again. Choose Eject and check your inventory.", "After loading, press {interact} again with an empty selected slot to open the panel.", "Choose Eject. If all slots are full, close the panel and collect the beaker beside the machine."),
), (
    goal: Textbook,
    objective: "Open a page in Pause > Lab Textbook.",
    explanation: "The textbook explains systems; the recipe book records methods. Come back whenever a system is unfamiliar.",
    marker: "Talk to Lab Instructor · {interact}",
    focus: "instructor",
    article: "experiments",
    hints: ("Close machine panels, press Escape, open Lab Textbook, and choose Handling glassware.", "In the textbook, select a topic to open its article.", "Press Escape to leave the article, again to return to Pause, then Resume."),
)],
),
(
    id: "request",
    title: "Understand the request",
    core: true,
    stages: [(
    goal: Converse,
    objective: "Hear the practice customer’s request.",
    explanation: "Conversation reveals what is needed. Looking at someone waiting does not commit you to their request.",
    marker: "Practice Customer · {interact}",
    focus: "customer",
    article: "orders",
    hints: ("Approach the Practice Customer and press {interact}.", "Aim at the Practice Customer until the interaction prompt appears.", "Close any open panel and stand closer to the customer if no prompt appears."),
), (
    goal: Accept,
    objective: "Accept the 10u Kelotane request.",
    explanation: "10u means 10 units, the game's measure of amount. Practice requests are untimed; in a career, accepting starts the preparation allowance.",
    marker: "Practice Customer · {interact}",
    focus: "customer",
    article: "orders",
    hints: ("Choose the acceptance response in the conversation.", "If the conversation is closed, aim at the customer and press {interact} again.", "Choose the response that accepts the request, then close the conversation."),
), (
    goal: Directory,
    objective: "Review the accepted order in the directory.",
    explanation: "Read the amount and chemical before making a batch. Exact orders and treatment-category orders are different.",
    marker: "Practice Customer · {interact}",
    focus: "customer",
    article: "orders",
    hints: ("Close the conversation. Press {social} and choose Orders.", "Press {social} while no machine or conversation panel is open.", "Choose Orders in the directory and read the Kelotane request."),
)],
),
(
    id: "batch",
    title: "Prepare a small batch",
    core: true,
    stages: [(
    goal: Book,
    objective: "Find Kelotane in the recipe book.",
    explanation: "Kelotane is one of your starting methods. Its equal ingredient proportions work at different batch sizes.",
    marker: "Use ChemMaster 5000 · {interact}",
    focus: "training.chemmaster5000",
    article: "ratios",
    hints: ("Press {book} and open the recorded Kelotane method.", "In the recipe book, select Kelotane to read its ingredients.", "Close the book before using the ChemMaster 5000. Use equal amounts of Silicon and Carbon."),
), (
    goal: Batch10,
    objective: "Prepare 10u of clean Kelotane.",
    explanation: "Predict the total before dispensing. Equal amounts of Silicon and Carbon become Kelotane.",
    marker: "Use ChemMaster 5000 · {interact}",
    focus: "training.chemmaster5000",
    article: "chemmaster5000",
    hints: ("Load a clean beaker. Select 5u and add Silicon once and Carbon once.", "After loading, use {interact} again with an empty hand to open the ChemMaster 5000 controls.", "For a fresh attempt, eject the current container and use an empty beaker with 5u of each ingredient."),
)],
),
(
    id: "delivery",
    title: "Verify and deliver",
    core: true,
    stages: [(
    goal: Analyze,
    objective: "Analyze your Kelotane sample.",
    explanation: "A label is a claim. Instruments measure what is actually present, including leftovers.",
    marker: "Use Sample Analyzer · {interact}",
    focus: "training.analyzer",
    article: "analyzer",
    hints: ("Load the beaker into the Sample Analyzer and choose Analyze.", "Eject your beaker from the ChemMaster 5000, select it, and use {interact} on the analyzer.", "Use the analyzer again with an empty hand to open its panel, then choose Analyze."),
), (
    goal: Package,
    objective: "Package the verified medicine in a bottle.",
    explanation: "The mixer transfers selected chemicals to its reservoir. A package carries a portion of everything in that reservoir.",
    marker: "Use Mixing Chamber · {interact}",
    focus: "training.mixer",
    article: "mixer",
    hints: ("Load the sample into the mixer. Extract all 10u Kelotane, choose Bottle, and Package.", "Eject the analyzed sample, load it into the mixer, and open the mixer controls.", "Select Kelotane and move all 10u to the reservoir. Package that reservoir as a Bottle."),
), (
    goal: Inspect,
    objective: "Inspect the newly packaged bottle.",
    explanation: "Check the label before handing it over. Default labels describe the packaged contents at creation time.",
    marker: "Use Mixing Chamber · {interact}",
    focus: "training.mixer",
    article: "labels",
    hints: ("Eject or collect your bottle, select it in the hotbar, and press {inspect}.", "Select the slot containing your new bottle, then press {inspect}.", "If the bottle is beside the mixer, close the panel and pick it up with {interact} first."),
), (
    goal: Deliver,
    objective: "Deliver the verified 10u bottle.",
    explanation: "Finish the job by handing over the actual prepared package. Read the result before starting another.",
    marker: "Practice Customer · {interact}",
    focus: "customer",
    article: "orders",
    hints: ("Close inspection, select the 10u bottle, and press {interact} on the Practice Customer.", "Select the bottle, aim at the waiting Practice Customer, and press {interact}.", "If the delivery fails, use the result to correct the batch, then bottle it and try the replacement request."),
)],
),
(
    id: "mistake",
    title: "Investigate a mistake",
    core: true,
    stages: [(
    goal: AnalyzeMistake,
    objective: "Analyze the supplied bottle.",
    explanation: "Measure before changing anything. A useful diagnosis begins with what is actually in the sample.",
    marker: "Use Sample Analyzer · {interact}",
    focus: "training.analyzer",
    article: "analyzer",
    hints: ("Take the labelled bottle from the sample bench to the Sample Analyzer. Load it and choose Analyze.", "Pick up the bottle labelled Kelotane on the sample bench and load it into the analyzer.", "Use the analyzer again with an empty hand to open its panel, then choose Analyze."),
), (
    goal: Repair,
    objective: "Recover a clean Kelotane batch.",
    explanation: "Now use your measurements. You can correct the leftover ratio, separate useful material, or remake the batch.",
    marker: "Use ChemMaster 5000 · {interact}",
    focus: "training.chemmaster5000",
    article: "ratios",
    hints: ("For the supplied analyzed sample, 5u Carbon consumes the 5u leftover Silicon and brings Kelotane to 20u.", "To separate instead, load the analyzed sample into the mixer and extract only Kelotane.", "To start fresh, use an empty beaker and dispense 5u Silicon plus 5u Carbon."),
)],
),
(
    id: "independent",
    title: "Work independently",
    core: true,
    stages: [(
    goal: Accept,
    objective: "Accept the first of two 10u Kelotane requests.",
    explanation: "Prepare 20u Kelotane for two customers, with 10u in each bottle. Use the sample you just fixed in the last lesson, or make a fresh batch.",
    marker: "Practice Customer · {interact}",
    focus: "customer",
    article: "orders",
    hints: ("Hear the new Practice Customer and accept their request.", "Aim at the Practice Customer, press {interact}, and choose the acceptance response.", "Prepare 20u total. Each customer needs a separate 10u bottle."),
), (
    goal: Analyze,
    objective: "Verify the 20u batch.",
    explanation: "Check composition before packaging. Larger batches use the same proportions.",
    marker: "Use Sample Analyzer · {interact}",
    focus: "training.analyzer",
    article: "analyzer",
    hints: ("Load your 20u Kelotane batch into the Sample Analyzer and choose Analyze.", "For a fresh 20u batch, dispense 10u Silicon and 10u Carbon into an empty beaker.", "Eject the sample, load it into the analyzer, open the panel, and choose Analyze."),
), (
    goal: Package,
    objective: "Package a bottle for the order.",
    explanation: "Prepare the requested amount without adding unwanted ingredients.",
    marker: "Use Mixing Chamber · {interact}",
    focus: "training.mixer",
    article: "packaging",
    hints: ("Extract only 10u Kelotane to the mixer and package a Bottle. Repeat for the second customer.", "Select Kelotane in the mixer and transfer 10u into its empty reservoir.", "Choose Bottle and Package. Keep the remaining 10u for the second customer."),
), (
    goal: Deliver,
    objective: "Deliver both 10u Kelotane bottles.",
    explanation: "Give each customer a 10u bottle. Inspection is optional now; select the bottle and hand it over.",
    marker: "Practice Customer · {interact}",
    focus: "customer",
    article: "orders",
    hints: ("Hand over the first 10u bottle. Accept the next customer and hand over the second 10u bottle.", "For each handoff, select a 10u bottle, aim at the accepted customer, and press {interact}.", "After the first handoff, accept the next customer. Extract and bottle the remaining 10u, then hand it over."),
)],
),
(
    id: "measurement",
    title: "Measurement and transfers",
    core: false,
    stages: [(
    goal: Measured,
    objective: "Make separate 10u and 20u Kelotane batches.",
    explanation: "Predict the total for each batch. Scaling both inputs preserves their ratio.",
    marker: "Use ChemMaster 5000 · {interact}",
    focus: "training.chemmaster5000",
    article: "ratios",
    hints: ("Make one batch with 5u each Silicon and Carbon, and another with 10u each.", "Use two empty beakers: 5u Silicon + 5u Carbon in one, 10u + 10u in the other.", "Keep the batches in separate beakers until this step completes."),
), (
    goal: Divided,
    objective: "Move part of a batch into the mixer reservoir.",
    explanation: "Transfers move material rather than creating more. Watch both source and destination.",
    marker: "Use Mixing Chamber · {interact}",
    focus: "training.mixer",
    article: "mixer",
    hints: ("Load one batch and extract part of its Kelotane; leave some in the beaker.", "Load the 20u batch into the mixer and transfer 5u Kelotane to the reservoir.", "Check that Kelotane remains in both the beaker and the reservoir before continuing."),
), (
    goal: Recombined,
    objective: "Combine the useful portions into 30u Kelotane.",
    explanation: "The two batches should add up to the same total after transfer.",
    marker: "Use Mixing Chamber · {interact}",
    focus: "training.mixer",
    article: "ratios",
    hints: ("Transfer both complete batches into the empty mixer reservoir, or return them to one beaker.", "Transfer the rest of the loaded beaker into the mixer reservoir.", "Eject the empty beaker, load the other batch, and transfer its Kelotane too. Aim for 30u total."),
)],
),
(
    id: "reports",
    title: "Labels, samples, and reports",
    core: false,
    stages: [(
    goal: AnalyzeMistake,
    objective: "Analyze the supplied sample.",
    explanation: "An analyzer report describes measured material, not the label’s claim.",
    marker: "Use Sample Analyzer · {interact}",
    focus: "training.analyzer",
    article: "analyzer",
    hints: ("Load the bottle and choose Analyze.", "Take the labelled bottle from the sample bench and load it into the analyzer.", "Open the analyzer controls with {interact}, then choose Analyze."),
), (
    goal: Printed,
    objective: "Print and collect a report.",
    explanation: "The paper records this scan. It can be carried and shared without changing the sample.",
    marker: "Use Sample Analyzer · {interact}",
    focus: "training.analyzer",
    article: "analyzer",
    hints: ("Choose Print Report and collect the printed sheet.", "Use Print Report in the analyzer panel after the scan finishes.", "Close the panel. Select a free slot and collect the printed sheet beside the analyzer with {interact}."),
), (
    goal: StaleReport,
    objective: "Change the measured sample.",
    explanation: "The paper remains a record of the earlier mixture. Change the same sample without swapping it for a new one, then it will need a fresh scan.",
    marker: "Use ChemMaster 5000 · {interact}",
    focus: "training.chemmaster5000",
    article: "analyzer",
    hints: ("Eject the sample, add 5u Carbon at the ChemMaster 5000, and compare it with the printed report.", "Eject the analyzed bottle, load it into the ChemMaster 5000, and open the controls.", "Set the ChemMaster 5000 to 5u and add Carbon once."),
), (
    goal: Reanalyzed,
    objective: "Analyze the changed sample again.",
    explanation: "Compare the new findings with your original printed record.",
    marker: "Use Sample Analyzer · {interact}",
    focus: "training.analyzer",
    article: "labels",
    hints: ("Load the changed sample and Analyze again.", "Eject the changed bottle from the ChemMaster 5000 and load it into the analyzer.", "Choose Analyze again. Read this fresh scan alongside the earlier printed report."),
)],
),
(
    id: "thermal",
    title: "Heating and cooling",
    core: false,
    stages: [(
    goal: Warm,
    objective: "Warm the Nitrogen sample toward 330K.",
    explanation: "Target temperature is a command; measured temperature is the sample’s current condition.",
    marker: "Use Reaction Chamber · {interact}",
    focus: "training.chamber",
    article: "chamber",
    hints: ("Load the supplied Nitrogen into the Reaction Chamber, power it, and set 330K. Wait for at least 325K.", "Open the Reaction Chamber controls, turn on temperature control, and set its target to 330K.", "Leave the sample loaded and wait until its current temperature reaches at least 325K."),
), (
    goal: RemovedWarm,
    objective: "Eject the warm sample.",
    explanation: "A sample continues exchanging heat outside the chamber. Removing it does not universally stop chemistry.",
    marker: "Use Reaction Chamber · {interact}",
    focus: "training.chamber",
    article: "temperature",
    hints: ("Use Eject and observe the sample after removing it.", "Choose Eject in the Reaction Chamber panel once the warm-up step completes.", "Collect the ejected sample if it lands beside the chamber. Keep it for the cooling step."),
), (
    goal: Cool,
    objective: "Cool that sample below 300K.",
    explanation: "Cooling changes the sample over time. Keep the target and measured values separate in your prediction.",
    marker: "Use Reaction Chamber · {interact}",
    focus: "training.chamber",
    article: "chamber",
    hints: ("Reload the same Nitrogen sample, set 295K, and wait until it reads below 300K.", "Reload the same sample, turn on temperature control, and set the target to 295K.", "Wait for the current temperature to fall below 300K. Setting the target alone does not finish cooling."),
)],
),
(
    id: "ph",
    title: "pH and buffers",
    core: false,
    stages: [(
    goal: PhShift,
    objective: "Adjust the Water sample to pH 8.",
    explanation: "A small buffer addition can make a meaningful change. Measure between corrections.",
    marker: "Use ChemMaster 5000 · {interact}",
    focus: "training.chemmaster5000",
    article: "buffers",
    hints: ("Add Basic Buffer to the supplied Water in 1u steps until the pH reaches 8. Check the reading after each addition.", "Load the supplied Water into the ChemMaster 5000 and open its controls to read the pH.", "Select 1u and keep adding Basic Buffer until the reading reaches pH 8. Read it after each addition."),
), (
    goal: PhStrip,
    objective: "Test the adjusted sample with pH paper.",
    explanation: "A strip gives a band; instruments give a precise reading. Neither proves the full composition.",
    marker: "Supply bench",
    focus: "supplies",
    article: "buffers",
    hints: ("Eject the sample, select unused pH paper, aim at the sample, and use {apply}.", "Put the adjusted sample on the floor with {drop}, then select unused pH paper.", "Aim at the sample from nearby and press {apply}. Use a fresh strip if your selected one is already used."),
), (
    goal: PhReturn,
    objective: "Bring that sample back near pH 7.",
    explanation: "If the reading is above 7, Acidic Buffer brings it down; if below 7, Basic Buffer brings it up. Add it in small steps to avoid overshooting.",
    marker: "Use ChemMaster 5000 · {interact}",
    focus: "training.chemmaster5000",
    article: "buffers",
    hints: ("Add Acidic Buffer in 1u steps until the same sample returns near pH 7. Check the reading after each addition.", "Reload the same adjusted sample into the ChemMaster 5000 and read its current pH.", "If above 7, add 1u Acidic Buffer at a time; if below 7, use Basic Buffer. Stop near 7."),
)],
),
(
    id: "extraction",
    title: "Extraction and purification",
    core: false,
    stages: [(
    goal: Ground,
    objective: "Grind Aloe into a receiving beaker.",
    explanation: "A plant carries useful extract and unwanted material. Extraction is the beginning of preparation.",
    marker: "Use Grinder · {interact}",
    focus: "training.grinder",
    article: "grinder",
    hints: ("Load an empty beaker into the grinder, place Aloe in its hopper, and Grind.", "Select an empty beaker and load it with {interact}; then select Aloe and use the grinder again.", "With an empty hand, use the grinder to open its controls and choose Grind."),
), (
    goal: Extracted,
    objective: "Separate Kelotane into the mixer reservoir.",
    explanation: "Separation can leave Plant Fibre behind without changing Kelotane’s own purity.",
    marker: "Use Mixing Chamber · {interact}",
    focus: "training.mixer",
    article: "purity",
    hints: ("Load the extract into the mixer. Select Kelotane and extract it without Plant Fibre.", "Eject the ground sample and load it into the mixer, then open the mixer controls.", "Select only Kelotane for transfer to the reservoir. Leave Plant Fibre in the beaker."),
), (
    goal: Purified,
    objective: "Purify a second Aloe sample with HPLC.",
    explanation: "This training analyzer is pre-calibrated. Purification retains less volume; check the useful sample and rejects.",
    marker: "Use Sample Analyzer · {interact}",
    focus: "training.analyzer",
    article: "hplc",
    hints: ("Grind the second Aloe, load its extract into the analyzer, select Kelotane, and Start purification.", "Use a receiving beaker to grind the remaining Aloe, then eject and load that extract into the analyzer.", "Select Kelotane for HPLC purification and start the run. Wait for it to finish before ejecting."),
)],
),
(
    id: "application",
    title: "Packaging and application",
    core: false,
    stages: [(
    goal: TwoForms,
    objective: "Package small Kelotane portions in two forms.",
    explanation: "A form determines how a dose is carried and applied. Keep the doses small.",
    marker: "Use Mixing Chamber · {interact}",
    focus: "training.mixer",
    article: "packaging",
    hints: ("Transfer 5u to an empty mixer and make a Patch. Repeat with 5u and a Syringe.", "Use the supplied Kelotane. Extract 5u into the empty mixer reservoir and choose Patch, then Package.", "Repeat with another 5u and choose Syringe, then Package. Keep the syringe for the patient."),
), (
    goal: Treated,
    objective: "Treat the Practice Patient with a measured dose.",
    explanation: "The practice patient has a burn. Observe recovery before giving more.",
    marker: "Practice Patient · {apply}",
    focus: "patient",
    article: "dose",
    hints: ("Hold the 5u Kelotane Syringe, aim at the Practice Patient, and press {apply}. Patches use {drink} on yourself.", "Select the 5u syringe in your hotbar and stand close to the Practice Patient.", "Aim at the patient until their name appears, then press {apply} once. Wait before giving more medicine."),
), (
    goal: Recovered,
    objective: "Observe the patient’s recovery.",
    explanation: "Dose, route, and time all matter. More medicine is not automatically better.",
    marker: "Practice Patient · {apply}",
    focus: "patient",
    article: "dose",
    hints: ("Allow the medicine to work and watch the patient before repeating any dose.", "Stay in the lab with the game unpaused while the medicine takes effect.", "Wait for this step to complete. Do not give another dose while the first is still working."),
)],
),
(
    id: "spills",
    title: "Spills and reactive materials",
    core: false,
    stages: [(
    goal: Puddle,
    objective: "Pour a small Water pool in the annex.",
    explanation: "Floor pools hold real material. Keep experimental spills away from the preparation bench.",
    marker: "Experiment here · {apply}",
    focus: "experiment",
    article: "materials",
    hints: ("Carry the 10u Water beaker in the annex, aim at the annex floor, and press {apply}.", "Select the 10u Water beaker in the annex and aim at the floor close to you.", "Press {apply} to pour. Stay in the annex for the next experiment."),
), (
    goal: Residue,
    objective: "Observe a small Potassium–Water reaction in the annex.",
    explanation: "A small reactive amount can still hurt. Completed compounds have their own properties; they do not simply inherit every ingredient’s hazards.",
    marker: "Experiment here · {apply}",
    focus: "experiment",
    article: "materials",
    hints: ("Using the two 1u beakers in the annex, pour Potassium and Water onto the same spot. Step back and observe Ash residue.", "Select the 1u Potassium beaker and pour onto a nearby spot with {apply}.", "Select the 1u Water beaker and pour onto the same spot. Move back and wait for the reaction."),
), (
    goal: Clean,
    objective: "Clear the spill bay with Reset spill bay.",
    explanation: "The training facility can reset the bay. In a career, use appropriate chemical cleanup and treat any injury.",
    marker: "Reset spill bay · {interact}",
    focus: "cleanup",
    article: "hazards",
    hints: ("Open Pause > Training help and choose Reset spill bay. Restart Exercise also restores your health and supplies.", "Press Escape, open Training help, and choose Reset spill bay.", "Resume to check the clear floor. To also restore health and supplies, use Restart exercise."),
)],
)
]
