// What the crew say out loud, in the room — see `src/speech/mod.rs`.
//
// `{name}` and `{role}` are substituted in. `role` restricts a line to one
// department; lines without it can be used by anyone, and every situation
// keeps a role-agnostic pool so a department nobody has written for yet is
// never struck mute.
//
// Keep these SHORT. A radio report is read off a card in the corner at
// leisure; this is read off someone's head while they walk past you, and a
// line long enough to need a second glance is a line the player misses.
//
// How long a line stays up is NOT authored here — it is derived from the
// text by `speech::speech_seconds`, because a client never loads this file
// and both ends have to agree. See the module doc.
(
    // How long before the same body will speak unprompted again. Long enough
    // that a resident pacing in and out of the lab doorway is not a
    // chatterbox, short enough that a real second visit gets a real greeting.
    cooldown_seconds: (16.0, 30.0),

    arrivals: [
        // ---- Errand -------------------------------------------------------
        // The one that matters. Someone has crossed the threshold on their way
        // to do something with their hands, and the player has the length of
        // the walk to decide whether to let them.
        //
        // Nothing here admits to anything. The tell is that it is too casual
        // for someone who has no business at your bench — the same kind of
        // tell `smuggler::loiter_smuggler` gives, and deliberately not a label.
        (situation: Errand, text: "Just going to check your glassware while I'm here."),
        (situation: Errand, text: "Won't be a second. Don't mind me."),
        (situation: Errand, text: "Need to get at something behind you."),
        (situation: Errand, text: "Ah — while I've got you. Two minutes."),
        (situation: Errand, role: Some("Engineering"), text: "Maintenance sweep. Standard. Very boring."),
        (situation: Errand, role: Some("Engineering"), text: "Just eyeballing your equipment. Regulations."),
        (situation: Errand, role: Some("Security"), text: "Routine look around. Carry on."),
        (situation: Errand, role: Some("Cargo"), text: "Stocktake. I count things. It's a whole thing."),

        // ---- Waiting ------------------------------------------------------
        // They came to collect something and are on their way to the counter.
        (situation: Waiting, tone: Urgent, text: "Chemistry — got a minute?"),
        (situation: Waiting, text: "Hi. I put an order in?"),
        (situation: Waiting, text: "Don't rush on my account. I'll be at the window."),
        (situation: Waiting, text: "There you are. I've been sent down for something."),
        (situation: Waiting, role: Some("Medical"), tone: Urgent, text: "Medbay's waiting on me. Please tell me it's ready."),
        (situation: Waiting, role: Some("Medical"), text: "Vance sent me. That's usually bad news for both of us."),
        (situation: Waiting, role: Some("Security"), text: "Chemistry. I'll wait. I'm very good at waiting."),
        (situation: Waiting, role: Some("Security"), tone: Wary, text: "Let's do this properly and we'll both have a nice day."),
        (situation: Waiting, role: Some("Engineering"), text: "Deck two's on fire. Metaphorically. Mostly."),
        (situation: Waiting, role: Some("Cargo"), text: "Signed for, stamped, and I'm still here. Wonderful."),
        (situation: Waiting, role: Some("Service"), text: "Bar's dry and the crew have noticed. No pressure."),

        // ---- Passing ------------------------------------------------------
        // A resident who lives here, just moving through. Most of what the
        // player ever hears — so it has to stay cheap and stay varied.
        (situation: Passing, text: "Don't mind me."),
        (situation: Passing, text: "Just cutting through."),
        (situation: Passing, text: "Afternoon."),
        (situation: Passing, text: "Smells expensive in here."),
        (situation: Passing, text: "Still no chairs in this department. Noted."),
        (situation: Passing, role: Some("Medical"), text: "Quiet shift. I'm not saying it out loud again."),
        (situation: Passing, role: Some("Medical"), text: "If anyone asks, I was never in chemistry."),
        (situation: Passing, role: Some("Security"), text: "Everything in order down here?"),
        (situation: Passing, role: Some("Security"), tone: Wary, text: "Long way round to the brig. Long way."),
        (situation: Passing, role: Some("Engineering"), text: "That vent's been making a noise for a week."),
        (situation: Passing, role: Some("Engineering"), text: "Whatever that smell is, it's not structural. Probably."),
        (situation: Passing, role: Some("Cargo"), text: "Anything going back up to Cargo?"),
        (situation: Passing, role: Some("Cargo"), text: "Half our crates come back here and never leave."),
        (situation: Passing, role: Some("Service"), text: "Kitchen's doing something brave with the protein."),
        (situation: Passing, role: Some("Service"), text: "Come up to the bar sometime. It's nicer than this."),

        // ---- Hostile ------------------------------------------------------
        // Short. Nobody making a speech is actually coming for you.
        (situation: Hostile, tone: Urgent, text: "Stay where you are."),
        (situation: Hostile, tone: Urgent, text: "Don't."),
        (situation: Hostile, tone: Urgent, text: "This was always going to happen."),
        (situation: Hostile, tone: Urgent, text: "You should have kept your head down."),

        // ---- Working ------------------------------------------------------
        // The residents the utility AI drives. Until these existed, the whole
        // migrated crew — most of the station — could not speak at all: they
        // carry no `Ambient`, no `Errand` and no `Order`, so every one of them
        // fell out of the situation match. See `Situation`'s doc comment.
        //
        // These people are AT WORK and the player is a colleague walking past,
        // not a customer. That is the register: half-attention, mid-task, not
        // a greeting.
        (situation: Working, text: "Mm. With you in a second."),
        (situation: Working, text: "Don't lean on that."),
        (situation: Working, text: "Nearly got this."),
        (situation: Working, text: "One thing at a time."),
        (situation: Working, text: "It was fine yesterday. It was."),
        (situation: Working, role: Some("Engineering"), text: "Third time this cycle on this same panel."),
        (situation: Working, role: Some("Engineering"), text: "If it hums, it's working. Mostly."),
        (situation: Working, role: Some("Botany"), text: "These beds want more light than they're getting."),
        (situation: Working, role: Some("Botany"), text: "Everything down here grows slower than the paperwork."),
        (situation: Working, role: Some("Service"), text: "Two hundred covers and one working burner."),
        (situation: Working, role: Some("Service"), text: "Mind the floor, it's just been done."),
        (situation: Working, role: Some("Medical"), text: "Stock check. Riveting."),
        (situation: Working, role: Some("Security"), text: "Paperwork. It's mostly paperwork."),
        (situation: Working, role: Some("Cargo"), text: "Manifest says twelve. There are nine."),

        // ---- Helping ------------------------------------------------------
        // Working, but not their own department's job. The assistants —
        // Boyle and Aleksy — spend most of their time here, and the tell is
        // that they sound slightly out of place, because they are.
        (situation: Helping, text: "Not my department, but here we are."),
        (situation: Helping, text: "They asked. I'm not going to say no."),
        (situation: Helping, text: "Somebody has to, apparently."),
        (situation: Helping, text: "I'm told this counts as cross-training."),
        (situation: Helping, text: "Don't tell my supervisor where I am."),
        (situation: Helping, role: Some("Engineering"), text: "I fix things. This is not a thing. I'm doing it anyway."),
        (situation: Helping, role: Some("Botany"), text: "I grow things. Ask me about anything else and you'll be disappointed."),

        // ---- Eating -------------------------------------------------------
        // Short and unbothered. Someone with a fork in their hand is not
        // going to hold a conversation.
        //
        // Density note (packet K): this pool and `Resting` below are the two a
        // player stands NEAR the longest — a mess hall is somewhere you linger,
        // unlike a corridor you cross — so repetition shows up here first, at a
        // lower line count than anywhere else.
        (situation: Eating, text: "Mm. Break."),
        (situation: Eating, text: "It's hot, at least."),
        (situation: Eating, text: "Twenty minutes. That's all I get."),
        (situation: Eating, text: "Don't ask what's in it."),
        (situation: Eating, text: "First thing I've eaten since the start of shift."),
        (situation: Eating, text: "Sit down, you're making the room nervous."),
        (situation: Eating, text: "It's fine. It's food. It's fine."),
        (situation: Eating, role: Some("Service"), text: "I made this, so I'm allowed to complain about it."),
        (situation: Eating, role: Some("Service"), text: "Nobody says thank you. Not once, all cycle."),
        (situation: Eating, role: Some("Engineering"), text: "Eating with my hands like this. Don't look."),
        (situation: Eating, role: Some("Medical"), text: "I've got eleven minutes and I'm counting them."),

        // ---- Resting ------------------------------------------------------
        (situation: Resting, text: "Five minutes. I've earned five minutes."),
        (situation: Resting, text: "Sitting down is the best part of this job."),
        (situation: Resting, text: "I'm on a break. Officially."),
        (situation: Resting, text: "Whatever it is, it can wait a bit."),
        (situation: Resting, text: "Don't tell me anything. Not for five minutes."),
        (situation: Resting, text: "My feet have opinions about this station."),
        (situation: Resting, text: "Ask me again when I'm standing up."),
        (situation: Resting, role: Some("Medical"), text: "First time I've sat down all shift."),
        (situation: Resting, role: Some("Security"), text: "I'm still watching. I'm just watching sitting down."),
        (situation: Resting, role: Some("Cargo"), text: "Everything I lift today, I lift after this."),

        // ---- Treating -----------------------------------------------------
        // Medical, working on a person. Deliberately never says how bad it is
        // — the patient's state is the player's to read off the body, not
        // something a line hands them.
        (situation: Treating, tone: Urgent, text: "Give me some room, please."),
        (situation: Treating, tone: Urgent, text: "I've got them. Stand back."),
        (situation: Treating, text: "They'll be fine. Probably want to sit down a while."),
        (situation: Treating, text: "Not the first one this shift."),
        (situation: Treating, tone: Wary, text: "I'd like to know what they'd been near."),
        (situation: Treating, tone: Urgent, text: "Keep the walkway clear, both of you."),
        (situation: Treating, text: "Breathing. That's the main thing."),
        (situation: Treating, tone: Wary, text: "They'll want to talk to somebody about this."),
        (situation: Treating, role: Some("Medical"), tone: Urgent, text: "I need this bay clear, not busy."),
        (situation: Treating, role: Some("Security"), text: "I'm no medic. I'm what's here."),

        // ---- Witnessed ----------------------------------------------------
        // Someone who saw handling that looked wrong, recently enough to still
        // be chewing on it. Until these existed the covert thread made no
        // sound whatsoever: an antagonist's approach was visible and silent,
        // so a player who happened not to be looking learned nothing.
        //
        // THE RULE, and it is not negotiable: NOT ONE OF THESE NAMES ANYBODY.
        //
        // The witness saw handling. They did not see intent, and they cannot
        // tell an antagonist from a colleague tidying up — `SuspiciousHandling`
        // is documented as "deliberately ambiguous: innocent and covert food
        // handling produce the same kind". A line naming a person would turn a
        // glimpse into an accusation and hand the player a conclusion the
        // fiction never earned. `interviews` is the only route to a name, and
        // it gets there from this same memory under questioning.
        //
        // So: no names, no roles, no departments, no "I saw X". Unease only.
        // `speech::tests::a_witness_never_names_anyone` enforces it.
        (situation: Witnessed, tone: Wary, text: "Probably nothing. Probably."),
        (situation: Witnessed, tone: Wary, text: "Did that get moved? I thought that got moved."),
        (situation: Witnessed, tone: Wary, text: "Something back there wasn't sitting right."),
        (situation: Witnessed, tone: Wary, text: "I'm sure there's a reason for it."),
        (situation: Witnessed, tone: Wary, text: "I wasn't really watching. I should have been."),
        (situation: Witnessed, text: "Odd sort of shift, this one."),
        (situation: Witnessed, tone: Wary, role: Some("Security"), text: "Nothing I could write up. Doesn't mean nothing."),
        (situation: Witnessed, tone: Wary, role: Some("Medical"), text: "I'd rather people didn't handle things they don't know."),
        (situation: Witnessed, tone: Wary, role: Some("Service"), text: "People wander through my kitchen like it's a corridor."),
    ],

    // Said as the errand is set, before they start walking — so the line and
    // the walk are one event rather than two.
    errands: [
        (text: "Right. Won't take a moment."),
        (text: "Fine. I'll do it myself."),
        (text: "No trouble. I know where it is."),
        (text: "Since nobody's serving, I'll help myself to a look."),
        (role: Some("Engineering"), text: "I'll just have a quick look at your glassware."),
        (role: Some("Engineering"), text: "Won't touch anything. Much."),
        (role: Some("Cargo"), text: "I'll take an inventory while I'm down here."),
        (role: Some("Security"), text: "Then I'll have a look for myself."),
    ],

    // What they say about how it went, at the counter, before they turn
    // around. The radio's own report is separate and still deliberately late.
    resolutions: [
        // ---- Success ------------------------------------------------------
        (outcome: Success, tone: Friendly, text: "That's the one. Thanks."),
        (outcome: Success, tone: Friendly, text: "Perfect. You're a lifesaver."),
        (outcome: Success, tone: Friendly, text: "Lovely. I'll put a word in for you."),
        (outcome: Success, role: Some("Medical"), tone: Friendly, text: "This'll do nicely. Back to the ward."),
        (outcome: Success, role: Some("Security"), tone: Friendly, text: "Clean work. I'll note that."),
        (outcome: Success, role: Some("Engineering"), tone: Friendly, text: "Grand. That's deck two sorted."),
        (outcome: Success, role: Some("Cargo"), tone: Friendly, text: "Signed for. Pleasure doing business."),
        (outcome: Success, role: Some("Service"), tone: Friendly, text: "The bar thanks you. Sincerely."),

        // ---- Short --------------------------------------------------------
        (outcome: Short, tone: Wary, text: "That's... less than I asked for."),
        (outcome: Short, tone: Wary, text: "Is this all of it?"),
        (outcome: Short, role: Some("Medical"), tone: Wary, text: "This won't cover the ward. I'll stretch it."),
        (outcome: Short, role: Some("Cargo"), tone: Wary, text: "I'll have to go back and explain this."),

        // ---- Impure -------------------------------------------------------
        (outcome: Impure, tone: Wary, text: "There's something else in here."),
        (outcome: Impure, tone: Wary, text: "It's cloudy. Should it be cloudy?"),
        (outcome: Impure, role: Some("Medical"), tone: Wary, text: "I can't put this in someone. Not like this."),
        (outcome: Impure, role: Some("Security"), tone: Wary, text: "That's not clean. I'll pretend I didn't see."),

        // ---- Overdose -----------------------------------------------------
        (outcome: Overdose, tone: Urgent, text: "That's far too strong. Far too strong."),
        (outcome: Overdose, tone: Urgent, text: "You've given me twice what I asked for."),
        (outcome: Overdose, role: Some("Medical"), tone: Urgent, text: "This would kill somebody. Do you understand?"),
        (outcome: Overdose, role: Some("Engineering"), tone: Urgent, text: "I'm not carrying this through a corridor."),

        // ---- Wrong --------------------------------------------------------
        (outcome: Wrong, tone: Wary, text: "This isn't what I came down for."),
        (outcome: Wrong, tone: Wary, text: "That's the wrong bottle entirely."),
        (outcome: Wrong, role: Some("Medical"), tone: Wary, text: "I asked for something else. Twice, I think."),
        (outcome: Wrong, role: Some("Security"), tone: Wary, text: "Wrong item. I'll be writing that down."),
        (outcome: Wrong, role: Some("Service"), tone: Wary, text: "Nobody's drinking this. Nobody."),

        // ---- Expired ------------------------------------------------------
        (outcome: Expired, tone: Wary, text: "Forget it. I'll sort it myself."),
        (outcome: Expired, tone: Wary, text: "I've waited long enough."),
        (outcome: Expired, role: Some("Medical"), tone: Wary, text: "I can't wait any longer. People are waiting on me."),
        (outcome: Expired, role: Some("Security"), tone: Wary, text: "Right. Noted, and remembered."),
        (outcome: Expired, role: Some("Engineering"), tone: Wary, text: "I'll bodge it. I always do."),
        (outcome: Expired, role: Some("Cargo"), tone: Wary, text: "Order's cancelled. Don't bother."),
    ],

    // What a utility-driven resident says when their own work ends badly.
    //
    // Only two outcomes are authored, and that is deliberate. `Completed` is
    // silent because most work completes and a line every time would be the
    // laugh track this module is trying not to become; `ReservationUnavailable`,
    // `InvalidTarget` and `TimedOut` are scheduler bookkeeping that no character
    // experiences as an event.
    //
    // The two that are left are the two the PLAYER caused or should know about:
    //
    //   Interrupted — you just stopped something. Until this existed, walking
    //   in on an act produced no acknowledgement whatsoever, so an interruption
    //   was indistinguishable from nothing having happened.
    //
    //   Unreachable — the stall signature, reaching the player through the
    //   fiction rather than through `ailog.txt`. If you start hearing these
    //   repeatedly in one room, something is genuinely wrong with the floor and
    //   the game has just told you so in character.
    //
    // Nothing here says WHAT the work was. A resident interrupted mid-sabotage
    // and one interrupted mid-repair draw from the same pool, for the same
    // reason the `Errand` pool does: a line that reads differently for a covert
    // act would label the act, and the tell is supposed to be behaviour.
    action_results: [
        // ---- Interrupted --------------------------------------------------
        (result: Interrupted, tone: Wary, text: "—right. Leaving that, then."),
        (result: Interrupted, tone: Wary, text: "I'll come back to it."),
        (result: Interrupted, tone: Wary, text: "Fine. Not now, apparently."),
        (result: Interrupted, text: "Hold on, I'd nearly finished that."),
        (result: Interrupted, tone: Wary, text: "That'll have to wait."),
        (result: Interrupted, role: Some("Engineering"), tone: Wary, text: "It'll still be broken later. It's patient."),
        (result: Interrupted, role: Some("Medical"), tone: Wary, text: "I'd rather not leave that half done."),
        (result: Interrupted, role: Some("Security"), tone: Wary, text: "We'll pick this up again."),
        (result: Interrupted, role: Some("Service"), tone: Wary, text: "That's going cold, whatever it was."),

        // ---- Unreachable --------------------------------------------------
        // Said as a complaint about the station, never about the player.
        (result: Unreachable, tone: Wary, text: "Can't get to it from here."),
        (result: Unreachable, tone: Wary, text: "There's no way through."),
        (result: Unreachable, tone: Wary, text: "Whatever's in the way, it's winning."),
        (result: Unreachable, tone: Wary, text: "I've been round twice. It's not happening."),
        (result: Unreachable, role: Some("Engineering"), tone: Wary, text: "You can't service what you can't stand next to."),
        (result: Unreachable, role: Some("Cargo"), tone: Wary, text: "Blocked. Again. I'll note it and nobody will read it."),
        (result: Unreachable, role: Some("Botany"), tone: Wary, text: "It's right there and I still can't reach it."),
    ],

    // On the way down. Short, because they are not finishing the sentence.
    collapses: [
        (tone: Urgent, text: "I don't— something's wrong—"),
        (tone: Urgent, text: "Wait. Wait, I can't—"),
        (tone: Urgent, text: "What was in that—"),
        (role: Some("Security"), tone: Urgent, text: "You did this—"),
        (role: Some("Medical"), tone: Urgent, text: "Get Vance. Get Vance now—"),
    ],

    // -----------------------------------------------------------------------
    // Gossip: what they tell you when you walk up empty-handed and ask.
    // -----------------------------------------------------------------------
    //
    // `when` conditions must ALL hold. An empty `when` is small talk, always
    // available, which is what stops anyone ever being mute.
    //
    // `weight` orders them: highest first, and each person works down the list
    // as you keep asking. Repeating themselves means nothing has changed since
    // you last asked — that is a signal, not a bug.
    //
    // THE RULE, enforced by
    // `every_authored_line_is_only_spoken_by_someone_who_could_know_it`:
    // a condition may only appear on a line whose `role` is one of the
    // departments `Knows::known_by` says could hold it. Security hears about
    // suspicion, Medical about the ward, Engineering about the station, Cargo
    // about stock, Service about the mood. A line that hands over a fact its
    // speaker has no way of knowing is a readout with a portrait attached, not
    // a clue.
    gossip: [
        // ---- Security: suspicion, contraband, the raid coming --------------
        (role: Some("Security"), when: [SuspicionHigh], weight: 90, tone: Urgent,
         text: "Between us? Your name's come up in a briefing. Twice."),
        (role: Some("Security"), when: [SuspicionHigh], weight: 88, tone: Urgent,
         text: "Warden's been asking who signs for what down here. I'd tidy up."),
        (role: Some("Security"), when: [SuspicionStirring], weight: 60, tone: Wary,
         text: "People have been asking questions about the lab. Not me. People."),
        (role: Some("Security"), when: [SuspicionStirring], weight: 58, tone: Wary,
         text: "Do yourself a favour and keep your paperwork straight this week."),
        (role: Some("Security"), when: [UnderworldActive], weight: 50, tone: Wary,
         text: "There's a market for something on this station. We haven't found the supplier."),
        (role: Some("Security"), when: [UnderworldActive], weight: 48, tone: Wary,
         text: "Somebody's moving product. Contraband locker's been busy."),

        // ---- Medical: the ward, and who keeps turning up in it -------------
        (role: Some("Medical"), when: [CrisisActive], weight: 95, tone: Urgent,
         text: "Not now — I've got someone going off in front of me."),
        (role: Some("Medical"), when: [CrewGettingHooked], weight: 70, tone: Wary,
         text: "Same faces keep coming back to the ward. Shaking. Nobody'll say why."),
        (role: Some("Medical"), when: [CrewGettingHooked], weight: 68, tone: Wary,
         text: "I've started keeping a list. It's getting longer than I'd like."),
        (role: Some("Medical"), when: [CrewGettingHooked], weight: 66, tone: Wary,
         text: "Withdrawal, if I had to write it down. I haven't written it down."),

        // ---- Engineering: the station itself -------------------------------
        (role: Some("Engineering"), when: [StationBreaking], weight: 92, tone: Urgent,
         text: "Nobody's holding this together any more. I've stopped pretending."),
        (role: Some("Engineering"), when: [StationFraying], weight: 64, tone: Wary,
         text: "Whole deck's gone sloppy. Work orders half done, nobody signing off."),
        (role: Some("Engineering"), when: [StationFraying], weight: 62, tone: Wary,
         text: "Something's off with this crew. It's not the wiring, before you ask."),
        (role: Some("Engineering"), when: [StationFraying], weight: 60, tone: Wary,
         text: "Third bodged repair I've found this week. Not mine."),

        // ---- Cargo: what has stopped coming back ---------------------------
        (role: Some("Cargo"), when: [StockGoingMissing], weight: 65, tone: Wary,
         text: "Stock's walking off. Manifest says one thing, shelf says another."),
        (role: Some("Cargo"), when: [StockGoingMissing], weight: 63, tone: Wary,
         text: "Glassware goes down to you and doesn't come back. I've noticed."),
        (role: Some("Cargo"), when: [StockGoingMissing], weight: 61, tone: Wary,
         text: "Somebody's signing for crates that never arrive. Not my handwriting."),

        // ---- Service: the mood, and whatever is under it -------------------
        (role: Some("Service"), when: [AntagSuspected], weight: 85, tone: Urgent,
         text: "People are frightened. Properly frightened, and they've stopped joking about it."),
        (role: Some("Service"), when: [PlotStirring], weight: 62, tone: Wary,
         text: "Crew's gone quiet at the bar. That's never once been good news."),
        (role: Some("Service"), when: [PlotStirring], weight: 60, tone: Wary,
         text: "Somebody's been acting strange. Won't say who. You'll see it yourself."),
        (role: Some("Service"), when: [PlotStirring], weight: 58, tone: Wary,
         text: "Two of the regulars stopped coming in. Nobody's saying where they went."),

        // ---- Anyone: it's on the board now ---------------------------------
        (when: [AntagNamed], weight: 80, tone: Urgent,
         text: "It's on the board. Everyone knows now. Small comfort."),
        (when: [AntagNamed], weight: 78, tone: Urgent,
         text: "They've named it. Doesn't make me feel better, mind."),

        // ---- Anyone: you've had the sign down too long ---------------------
        // Weighted above an ordinary grudge: this is the thing they came over
        // to say, and it is the one the player can fix in one keypress.
        (when: [LabHasBeenShut], weight: 68, tone: Wary,
         text: "You've had that sign down a long while. People have noticed."),
        (when: [LabHasBeenShut], weight: 66, tone: Wary,
         text: "Are you open or not? Nobody upstairs can get a straight answer."),
        (when: [LabHasBeenShut], weight: 64, tone: Wary,
         text: "I came down twice already. Twice, to a closed window."),
        (role: Some("Medical"), when: [LabHasBeenShut], weight: 70, tone: Urgent,
         text: "I have people waiting and you're not taking requests. Sort it out."),
        (role: Some("Cargo"), when: [LabHasBeenShut], weight: 69, tone: Wary,
         text: "I've stock on the dock for a lab that won't open. It's not staying there."),

        // ---- Anyone: how they personally feel about you --------------------
        (when: [Estranged], weight: 75, tone: Wary,
         text: "I've nothing to say to you."),
        (when: [Estranged], weight: 73, tone: Wary,
         text: "We're done, you and me. Ask somebody else."),
        (when: [ResentsYou], weight: 40, tone: Wary,
         text: "You've cost me more than once. I've not forgotten."),
        (when: [ResentsYou], weight: 38, tone: Wary,
         text: "I'd rather deal with anyone else, frankly."),
        (when: [Withdrawing], weight: 72, tone: Urgent,
         text: "You know what I need. Don't make me say it out loud."),
        (when: [LikesYou], weight: 35, tone: Friendly,
         text: "You've done right by me. That counts for something up here."),
        (when: [LikesYou], weight: 33, tone: Friendly,
         text: "Any time you need something from my department, you ask me first."),
        (when: [DepartmentPleased], weight: 25, tone: Friendly,
         text: "You're well thought of in my lot at the moment. Enjoy it."),

        // ---- Small talk: always available, so nobody is ever mute ----------
        (weight: 5, text: "Nothing much. Same shift, different day."),
        (weight: 5, text: "Quiet enough. I'm not complaining about quiet."),
        (weight: 5, text: "Long way from home, this place."),
        (role: Some("Medical"), weight: 6, text: "Ward's holding. Ask me again in an hour."),
        (role: Some("Security"), weight: 6, text: "No incidents. Which is its own kind of suspicious."),
        (role: Some("Engineering"), weight: 6, text: "Everything's held together with tape and optimism. As usual."),
        (role: Some("Cargo"), weight: 6, text: "Shuttle's late. Shuttle's always late."),
        (role: Some("Service"), weight: 6, text: "Bar's open, if you ever leave this room."),
    ],

    // Once they've told you everything they have. Deliberately a little flat:
    // this is the sound of nothing having changed since you last asked.
    exhausted: [
        (text: "That's all I've got."),
        (text: "Nothing new since you last asked."),
        (text: "You've had everything I know."),
        (role: Some("Security"), text: "Nothing further to report."),
        (role: Some("Medical"), text: "No change. I'd tell you if there were."),
        (role: Some("Engineering"), text: "Same as it was five minutes ago."),
        (role: Some("Cargo"), text: "Nothing else on the manifest."),
        (role: Some("Service"), text: "Same as I said. Come up to the bar if you want more."),
    ],

    // Two residents standing together, for you to overhear. `when` is checked
    // against the OPENER, so the same knowledge rule applies — an exchange
    // that leaks a department's clue must be opened by that department.
    exchange_gap_seconds: (70.0, 130.0),
    exchanges: [
        (lines: [
            (text: "You been down to chemistry lately?"),
            (text: "Once. Smelled like a bad decision."),
        ]),
        (lines: [
            (text: "Did they ever fix the light in the corridor?"),
            (text: "They fixed it. Then it broke. Then they fixed it again."),
            (text: "So no, then."),
        ]),
        (lines: [
            (text: "Long shift?"),
            (text: "Every shift is a long shift."),
        ]),
        (role: Some("Security"), when: [SuspicionStirring], lines: [
            (tone: Wary, text: "Heard the Warden's taking an interest in the lab."),
            (tone: Wary, text: "About time somebody did."),
        ]),
        (role: Some("Security"), when: [UnderworldActive], lines: [
            (tone: Wary, text: "Somebody's selling something on this station."),
            (tone: Wary, text: "Somebody's always selling something."),
            (tone: Wary, text: "Not like this."),
        ]),
        (role: Some("Medical"), when: [CrewGettingHooked], lines: [
            (tone: Wary, text: "That's the third one this week with the shakes."),
            (tone: Wary, text: "Don't say that where anyone can hear you."),
        ]),
        (role: Some("Engineering"), when: [StationFraying], lines: [
            (tone: Wary, text: "Nobody's finishing their work orders."),
            (tone: Wary, text: "Nobody's finishing anything."),
        ]),
        (role: Some("Cargo"), when: [StockGoingMissing], lines: [
            (tone: Wary, text: "Another crate short on the manifest."),
            (tone: Wary, text: "Don't look at me. I sign for what arrives."),
        ]),
        (role: Some("Service"), when: [PlotStirring], lines: [
            (tone: Wary, text: "Have you noticed how quiet the bar's got?"),
            (tone: Wary, text: "I'd noticed. I was hoping I was wrong."),
        ]),
        (lines: [
            (text: "What do you reckon they actually do in there?"),
            (text: "Chemistry, I assume. It's on the door."),
        ]),
    ],
)
