// Radio chatter. `{name}`, `{role}` and `{reagent}` are substituted in.
//
// `role` restricts a line to one department; lines without it can be used by
// anyone. Role-specific lines are preferred when one is available, so security
// sounds like security.
//
// The delay is the point of the whole feature: the report arrives long after
// the handover, so it reads as the station reacting rather than a score popup.
(
    delay_seconds: (12.0, 38.0),
    lines: [
        // ---- Success ------------------------------------------------------
        (outcome: Success, text: "{name} here. That {reagent} did exactly what it said on the bottle. He's up and walking."),
        (outcome: Success, text: "Chem lab, {name}. Clean batch of {reagent}. Whoever's on shift down there, good pour."),
        (outcome: Success, text: "Patient's stable. The {reagent} took about a minute. Nice work, chemistry."),
        (outcome: Success, role: Some("Security"), text: "Reyes to chem lab — that {reagent} got my officer back on the door inside ten minutes. Appreciated."),
        (outcome: Success, role: Some("Medical"), text: "Medbay to chemistry. {reagent} was textbook. Send more when you can."),
        (outcome: Success, role: Some("Engineering"), text: "Engineering — burns are dressed and he's back on the coolant line. That {reagent} was spot on."),

        // Department voice pool: success.
        (outcome: Success, role: Some("Medical"), text: "The {reagent} worked perfectly. The chart now says 'unexpectedly competent' and Vance is furious."),
        (outcome: Success, role: Some("Medical"), text: "Patient stable after {reagent}. We may have to revise our theory that Chemistry is decorative."),
        (outcome: Success, role: Some("Medical"), text: "Clean response to {reagent}. The patient is asking for lunch, which is Service's emergency now."),
        (outcome: Success, role: Some("Security"), text: "The {reagent} worked. The officer is upright and asking the vending machine for identification."),
        (outcome: Success, role: Some("Security"), text: "Clean result on the {reagent}. Security considers the patient rehabilitated and the chair cautioned."),
        (outcome: Success, role: Some("Security"), text: "Patient recovered after {reagent}. The incident has been downgraded from assault to furniture dispute."),
        (outcome: Success, role: Some("Engineering"), text: "The {reagent} took. He's back inside the wall, which is apparently where his shift lives."),
        (outcome: Success, role: Some("Engineering"), text: "Good batch of {reagent}. Patient fixed; warranty sticker reapplied."),
        (outcome: Success, role: Some("Engineering"), text: "That {reagent} worked. We have returned the engineer to service with three screws left over."),
        (outcome: Success, role: Some("Cargo"), text: "The {reagent} worked. Cargo returned the patient to inventory in condition: mostly original."),
        (outcome: Success, role: Some("Cargo"), text: "Clean {reagent}, quick recovery. The incident form is only four pages now."),
        (outcome: Success, role: Some("Cargo"), text: "Patient's up after {reagent}. We cancelled the replacement order and its attractive bulk discount."),
        (outcome: Success, role: Some("Service"), text: "The {reagent} worked. Dinner service remains open and legally distinct from the incident."),
        (outcome: Success, role: Some("Service"), text: "Patient stable after {reagent}. Chef has put away the emergency rolling pin."),
        (outcome: Success, role: Some("Service"), text: "That {reagent} did it. Botany resumed watering the plants instead of the patient."),

        // ---- Short --------------------------------------------------------
        (outcome: Short, text: "{name} again. That was nowhere near enough {reagent}. Had to ration it."),
        (outcome: Short, text: "Chem lab, we ran dry halfway through. Need a proper measure of {reagent} next time."),
        (outcome: Short, role: Some("Medical"), text: "Medbay. The {reagent} ran out mid-treatment. He'll live, but it was close."),

        // Department voice pool: short dose.
        (outcome: Short, role: Some("Medical"), text: "Dose of {reagent} was short. We finished with optimism, which is not in the formulary."),
        (outcome: Short, role: Some("Medical"), text: "Not enough {reagent}. Patient stable; dignity unavailable in the requested quantity."),
        (outcome: Short, role: Some("Medical"), text: "The {reagent} ran out. We substituted bedside manner and remembered why we do not do that."),
        (outcome: Short, role: Some("Security"), text: "The {reagent} came up short. The officer opened an investigation into fractions."),
        (outcome: Short, role: Some("Security"), text: "Insufficient {reagent}. Security has a case against whoever stole the rest from the beaker."),
        (outcome: Short, role: Some("Security"), text: "We needed a full dose of {reagent}. What arrived was a strongly worded suggestion."),
        (outcome: Short, role: Some("Engineering"), text: "Short on {reagent}. We bridged the gap with tape; Medical asked us never to say that again."),
        (outcome: Short, role: Some("Engineering"), text: "Not enough {reagent}. Patient is operational but making the noise called 'concerning'."),
        (outcome: Short, role: Some("Engineering"), text: "The {reagent} ran dry. We got them moving with a bypass nobody may inspect."),
        (outcome: Short, role: Some("Cargo"), text: "Shipment contained too little {reagent}. The packing slip was emotionally complete."),
        (outcome: Short, role: Some("Cargo"), text: "Short dose of {reagent}. Cargo rejects the claim that people cannot be back-ordered."),
        (outcome: Short, role: Some("Cargo"), text: "Quantity of {reagent} was under spec. Attach the missing medicine to form C-12."),
        (outcome: Short, role: Some("Service"), text: "Not enough {reagent}. We stretched it with presentation and garnish; results looked medical."),
        (outcome: Short, role: Some("Service"), text: "The {reagent} ran out halfway. Chef requests future portions respect the tasting menu."),
        (outcome: Short, role: Some("Service"), text: "Short on {reagent}. Botanist Ivy says the patient needed watering anyway."),

        // ---- Impure -------------------------------------------------------
        (outcome: Impure, text: "{name} here. There was something else swimming in that {reagent}. Worked, mostly. Mostly."),
        (outcome: Impure, text: "Chem lab — this {reagent} is cloudy. Is it meant to be cloudy?"),
        (outcome: Impure, role: Some("Medical"), text: "Medbay to chemistry. Your {reagent} had contaminants. Patient's fine, but run it through the Mixing Chamber next time."),
        (outcome: Impure, role: Some("Security"), text: "Whatever was mixed in with that {reagent} gave him a rash. He's not pleased about it."),

        // Department voice pool: contaminated batch.
        (outcome: Impure, role: Some("Medical"), text: "The {reagent} treated the injury and introduced a sequel. Purify the next batch."),
        (outcome: Impure, role: Some("Medical"), text: "Contaminants in the {reagent}. Patient survived; the sample is now teaching material."),
        (outcome: Impure, role: Some("Medical"), text: "Dirty {reagent}. It worked, but so does a fall down the stairs in selected cases."),
        (outcome: Impure, role: Some("Security"), text: "The {reagent} worked, but contained evidence. Security is bagging the evidence and scratching."),
        (outcome: Impure, role: Some("Security"), text: "Contaminated {reagent}. The officer is stable and has detained the rash."),
        (outcome: Impure, role: Some("Security"), text: "Unknown substance in the {reagent}. Chemistry is requested to stop creating suspects."),
        (outcome: Impure, role: Some("Engineering"), text: "The {reagent} worked through contamination. So does the reactor; we do not call it clean."),
        (outcome: Impure, role: Some("Engineering"), text: "Dirty batch of {reagent}. Patient is fixed and smells faintly of the cable locker."),
        (outcome: Impure, role: Some("Engineering"), text: "Something rode in with the {reagent}. We isolated the patient from instruments and lunch."),
        (outcome: Impure, role: Some("Cargo"), text: "The {reagent} arrived contaminated. Cargo accepts mixed pallets, not pharmacology."),
        (outcome: Impure, role: Some("Cargo"), text: "Impurities in the {reagent}. The manifest lists them as complimentary accessories."),
        (outcome: Impure, role: Some("Cargo"), text: "That {reagent} was not a single-item shipment. Refund pending until the sun burns out."),
        (outcome: Impure, role: Some("Service"), text: "The {reagent} worked but had notes of industrial solvent and regret."),
        (outcome: Impure, role: Some("Service"), text: "Contaminated {reagent}. Chef says if it separates in the glass, it is not a sauce."),
        (outcome: Impure, role: Some("Service"), text: "The patient recovered and the {reagent} grew a skin. Botany would like the skin."),

        // ---- Overdose -----------------------------------------------------
        (outcome: Overdose, text: "MEDBAY — we have a reaction to that {reagent}! Who signed off on this dose?"),
        (outcome: Overdose, text: "{name} to chem lab. That pill nearly finished the job the injury started. Check your thresholds."),
        (outcome: Overdose, role: Some("Medical"), text: "Chemistry, this is medbay. That was well over the safe dose of {reagent}. We're treating the treatment now."),
        (outcome: Overdose, role: Some("Security"), text: "Officer's convulsing. That {reagent} dose was far too strong. Someone's answering for this."),

        // Department voice pool: overdose.
        (outcome: Overdose, role: Some("Medical"), text: "Overdose on {reagent}. We are treating Chemistry's confidence as a comorbidity."),
        (outcome: Overdose, role: Some("Medical"), text: "The {reagent} exceeded the safe threshold. We put the dosage chart where orbit can see it."),
        (outcome: Overdose, role: Some("Medical"), text: "Far too much {reagent}. Patient alive; your measuring cylinder has lost unsupervised privileges."),
        (outcome: Overdose, role: Some("Security"), text: "Excess {reagent}. The officer has arrested their own pulse for speeding."),
        (outcome: Overdose, role: Some("Security"), text: "Too much {reagent}. Patient restrained, beaker cited, paperwork breeding."),
        (outcome: Overdose, role: Some("Security"), text: "Overdose confirmed. Security is treating the dose as chemical excessive force."),
        (outcome: Overdose, role: Some("Engineering"), text: "Way too much {reagent}. You redlined a person, Chemistry."),
        (outcome: Overdose, role: Some("Engineering"), text: "The {reagent} exceeded tolerance. Patient entered emergency shutdown without a permit."),
        (outcome: Overdose, role: Some("Engineering"), text: "Overdose confirmed. We asked for a repair, not an overclock."),
        (outcome: Overdose, role: Some("Cargo"), text: "Excess {reagent} received. Cargo appreciates generosity in every category except medicine."),
        (outcome: Overdose, role: Some("Cargo"), text: "Too much {reagent}. The surplus has been logged as a hostile delivery."),
        (outcome: Overdose, role: Some("Cargo"), text: "Patient overdosed on {reagent}. Bulk pricing is not a clinical guideline."),
        (outcome: Overdose, role: Some("Service"), text: "Too much {reagent}. This is a hospital dose, not bottomless brunch."),
        (outcome: Overdose, role: Some("Service"), text: "The {reagent} was dangerously strong. Chef revoked Chemistry's ladle privileges."),
        (outcome: Overdose, role: Some("Service"), text: "Overdose confirmed. Ivy asks whether the patient should be moved into indirect light."),

        // ---- Wrong --------------------------------------------------------
        (outcome: Wrong, text: "{name} here. I asked for {reagent}. This is not {reagent}. I don't know what this is."),
        (outcome: Wrong, text: "Chem lab — did anyone actually read my order? There's no {reagent} in this at all."),
        (outcome: Wrong, role: Some("Security"), text: "Reyes to chemistry. Wrong chemical entirely. I'm logging this one."),
        (outcome: Wrong, role: Some("Service"), text: "I don't think this is {reagent}. I think this is floor cleaner. Please advise."),

        // Department voice pool: wrong chemical.
        (outcome: Wrong, role: Some("Medical"), text: "No {reagent} in this. We asked for treatment, not a diagnostic mystery box."),
        (outcome: Wrong, role: Some("Medical"), text: "Wrong chemical entirely. The patient now has the original problem plus tasting notes."),
        (outcome: Wrong, role: Some("Medical"), text: "This is not {reagent}. Vance has labelled it 'future pathology conference'."),
        (outcome: Wrong, role: Some("Security"), text: "No {reagent} present. Security has charged the bottle with impersonating medicine."),
        (outcome: Wrong, role: Some("Security"), text: "Wrong chemical. The evidence has confessed more readily than Chemistry."),
        (outcome: Wrong, role: Some("Security"), text: "This is not {reagent}. Return to sender, pending interview."),
        (outcome: Wrong, role: Some("Engineering"), text: "Wrong chemical. We requested {reagent}; this appears to be a different kind of problem."),
        (outcome: Wrong, role: Some("Engineering"), text: "No {reagent} in the batch. Wrong fitting, wrong thread, wrong patient."),
        (outcome: Wrong, role: Some("Engineering"), text: "This is not {reagent}. We cannot hit medicine with a wrench until it fits."),
        (outcome: Wrong, role: Some("Cargo"), text: "Wrong item delivered. The manifest says {reagent}; the bottle says practical joke."),
        (outcome: Wrong, role: Some("Cargo"), text: "No {reagent} received. Cargo will issue store credit after the heat death of the station."),
        (outcome: Wrong, role: Some("Cargo"), text: "This is not {reagent}. It has been moved to Unclaimed Freight and is already unionizing."),
        (outcome: Wrong, role: Some("Service"), text: "Wrong chemical. We asked for {reagent}; this could strip a griddle."),
        (outcome: Wrong, role: Some("Service"), text: "No {reagent} here. Chef tasted it, which has created a second order."),
        (outcome: Wrong, role: Some("Service"), text: "This is not {reagent}. Botany has accepted it, but Botany accepts compost."),

        // ---- Expired ------------------------------------------------------
        (outcome: Expired, text: "{name} to chem lab. Waited as long as I could for that {reagent}. Gone to find it elsewhere."),
        (outcome: Expired, text: "Cancel the {reagent}. We sorted it ourselves. Took longer than it should have."),
        (outcome: Expired, role: Some("Medical"), text: "Medbay. We needed that {reagent} twenty minutes ago. Had to improvise."),
        // Department voice pool: expired request.
        (outcome: Expired, role: Some("Medical"), text: "The {reagent} never arrived. We improvised; the incident report is now a novella."),
        (outcome: Expired, role: Some("Medical"), text: "Too late for the {reagent}. Patient stable, clock under observation."),
        (outcome: Expired, role: Some("Medical"), text: "Cancel {reagent}. Vance solved it with medicine and an unacceptable amount of smugness."),
        (outcome: Expired, role: Some("Security"), text: "The {reagent} missed the deadline. Security has issued time a formal warning."),
        (outcome: Expired, role: Some("Security"), text: "Cancel {reagent}. The officer recovered and is coming to discuss response times."),
        (outcome: Expired, role: Some("Security"), text: "Too late. The case against waiting remains open."),
        (outcome: Expired, role: Some("Engineering"), text: "The {reagent} did not arrive. We bypassed the injury; do not ask where it vents."),
        (outcome: Expired, role: Some("Engineering"), text: "Cancel {reagent}. Patient fixed with field methods and one borrowed door hinge."),
        (outcome: Expired, role: Some("Engineering"), text: "Too late for {reagent}. The engineer returned to work out of professional spite."),
        (outcome: Expired, role: Some("Cargo"), text: "Order for {reagent} expired. Cargo has marked Chemistry as a weather-related delay."),
        (outcome: Expired, role: Some("Cargo"), text: "Cancel {reagent}. Replacement sourced locally at a horrifying markup."),
        (outcome: Expired, role: Some("Cargo"), text: "The deadline passed. Your shipment is now being delivered conceptually."),
        (outcome: Expired, role: Some("Service"), text: "The {reagent} never came. We handled it tableside; reviews are mixed."),
        (outcome: Expired, role: Some("Service"), text: "Cancel {reagent}. Chef improvised, which Medical would like us to stop saying."),
        (outcome: Expired, role: Some("Service"), text: "Too late. Ivy used a poultice and refuses to disclose whether it was a plant."),
    ],

    // A legitimate order names a kind of chemical, not a specific one — so
    // when nothing in the delivery ever matched what was needed, there is no
    // reagent left to name. These lines use `{category}` instead of
    // `{reagent}` and only ever fire for Wrong/Expired, the two outcomes a
    // legitimate order can resolve to with nothing matched at all.
    category_lines: [
        (outcome: Wrong, text: "{name} here. I asked for {category}. This isn't it. I don't know what this is."),
        (outcome: Wrong, text: "Chem lab — did anyone actually read my order? There's no {category} in this at all."),
        (outcome: Wrong, role: Some("Security"), text: "Reyes to chemistry. Wrong chemical entirely. I'm logging this one."),
        (outcome: Wrong, role: Some("Service"), text: "I don't think this is {category}. I think this is floor cleaner. Please advise."),

        (outcome: Expired, text: "{name} to chem lab. Waited as long as I could for some {category}. Gone to find it elsewhere."),
        (outcome: Expired, text: "Cancel the order. We needed {category}, not a wait. Sorted it ourselves in the end."),
        (outcome: Expired, role: Some("Medical"), text: "Medbay. We needed {category} twenty minutes ago. Had to improvise."),
        // Department voice pool for category-only failures.
        (outcome: Wrong, role: Some("Medical"), text: "This is not {category}. It is, however, a compelling argument for labelling."),
        (outcome: Wrong, role: Some("Medical"), text: "No {category} in the dose. Patient unchanged; Vance's opinion has metastasized."),
        (outcome: Wrong, role: Some("Medical"), text: "Wrong treatment category. We needed {category}, not an elective complication."),
        (outcome: Wrong, role: Some("Security"), text: "No {category} present. Security has detained the container under an assumed identity."),
        (outcome: Wrong, role: Some("Security"), text: "Wrong chemical class. We asked for {category}; this is resisting categorization."),
        (outcome: Wrong, role: Some("Security"), text: "This is not {category}. Evidence logged, bottle uncooperative."),
        (outcome: Wrong, role: Some("Engineering"), text: "Wrong system entirely. We needed {category}; this connects to the patient only emotionally."),
        (outcome: Wrong, role: Some("Engineering"), text: "No {category} in it. Chemistry has supplied a spare part for a different species."),
        (outcome: Wrong, role: Some("Engineering"), text: "This is not {category}. We tried rotating it ninety degrees; still medicine-shaped nonsense."),
        (outcome: Wrong, role: Some("Cargo"), text: "Wrong commodity. Manifest requested {category}; delivery contained surprise."),
        (outcome: Wrong, role: Some("Cargo"), text: "No {category} received. Claim denied because the bottle arrived physically."),
        (outcome: Wrong, role: Some("Cargo"), text: "This is not {category}. It is now surplus stock with dangerous ambitions."),
        (outcome: Wrong, role: Some("Service"), text: "Wrong order. We needed {category}; this has the mouthfeel of disciplinary action."),
        (outcome: Wrong, role: Some("Service"), text: "No {category} here. Chef garnished it and the garnish resigned."),
        (outcome: Wrong, role: Some("Service"), text: "This is not {category}. Botany says it may still be useful against aphids or walls."),
        (outcome: Expired, role: Some("Medical"), text: "The {category} never arrived. We treated the patient with medicine from Medical, somehow."),
        (outcome: Expired, role: Some("Medical"), text: "Too late for {category}. Patient stable; request pronounced dead at the scene."),
        (outcome: Expired, role: Some("Medical"), text: "Cancel the {category}. Vance finished treatment and began a lecture with no known endpoint."),
        (outcome: Expired, role: Some("Security"), text: "The {category} missed its deadline. Time remains at large."),
        (outcome: Expired, role: Some("Security"), text: "Cancel {category}. Security resolved the matter using procedure and a very fast chair."),
        (outcome: Expired, role: Some("Security"), text: "Too late. Failure to deliver {category} has been added to the failure-to-deliver file."),
        (outcome: Expired, role: Some("Engineering"), text: "The {category} did not arrive. We bypassed the patient; Medical objects to the terminology."),
        (outcome: Expired, role: Some("Engineering"), text: "Cancel {category}. Field repair complete, original parts not guaranteed."),
        (outcome: Expired, role: Some("Engineering"), text: "Too late. The engineer rebooted after percussive maintenance."),
        (outcome: Expired, role: Some("Cargo"), text: "Order for {category} expired. Estimated delivery is now last Thursday."),
        (outcome: Expired, role: Some("Cargo"), text: "Cancel {category}. We sourced it from a crate labelled Definitely Not Medical."),
        (outcome: Expired, role: Some("Cargo"), text: "Deadline passed. Cargo has invoiced Chemistry for the concept of waiting."),
        (outcome: Expired, role: Some("Service"), text: "The {category} never arrived. We comped the patient a dessert and legal waiver."),
        (outcome: Expired, role: Some("Service"), text: "Cancel {category}. Chef improvised; the smoke is unrelated until proven otherwise."),
        (outcome: Expired, role: Some("Service"), text: "Too late. Ivy used something from a pot she refuses to identify."),
    ],

    ambient_gap_seconds: Some((75.0, 120.0)),
    ambient_lines: [
        (channel: Medical, speaker: "Dr. Vance", text: "Reminder: 'walk it off' is not an approved discharge plan. It remains Engineering's most popular one."),
        (channel: Medical, speaker: "Nurse Okonkwo", text: "Who returned the skeleton model to Medbay with one extra rib and a Cargo barcode?"),
        (channel: Medical, speaker: "Dr. Vance", text: "Medbay is out of tongue depressors. Security, stop booking them as tiny batons."),
        (channel: Medical, speaker: "Nurse Okonkwo", text: "Patient in bed three insists he is allergic to forms. Security has prescribed more forms."),
        (channel: Medical, speaker: "Dr. Vance", text: "The good news is the scanner works. The bad news is it has opinions."),
        (channel: Medical, speaker: "Nurse Okonkwo", text: "Medical requests whoever owns the loose organ in the break room retrieve it before lunch."),

        (channel: Security, speaker: "Officer Reyes", text: "Security notice: the clown horn is not contraband. It is now evidence, which is much worse."),
        (channel: Security, speaker: "Warden Bex", text: "Whoever labelled the brig minibar 'emotional support evidence' has ten minutes."),
        (channel: Security, speaker: "Officer Reyes", text: "The station map is not upside down. Cargo is simply south of accountability."),
        (channel: Security, speaker: "Warden Bex", text: "Security drill complete. The hostage was a mop and has declined to press charges."),
        (channel: Security, speaker: "Officer Reyes", text: "Lost property: one pair of handcuffs, currently occupied."),
        (channel: Security, speaker: "Warden Bex", text: "Reminder: being technically correct does not grant access to the evidence locker, Lindqvist."),

        (channel: Engineering, speaker: "Tech Lindqvist", text: "Engineering status: the noise has stopped. We are deciding whether this is better."),
        (channel: Engineering, speaker: "Tech Lindqvist", text: "Who signed the air scrubber out as a karaoke machine? It has learned harmony."),
        (channel: Engineering, speaker: "Tech Lindqvist", text: "Power fluctuation resolved. The lights were blinking because they were afraid."),
        (channel: Engineering, speaker: "Tech Lindqvist", text: "Maintenance request denied: the wall is load-bearing and emotionally unavailable."),
        (channel: Engineering, speaker: "Tech Lindqvist", text: "If anyone finds a wrench humming at sixty hertz, do not encourage it."),
        (channel: Engineering, speaker: "Tech Lindqvist", text: "The coolant line is within tolerance. Tolerance has filed a complaint."),

        (channel: Cargo, speaker: "Miner Sato", text: "Cargo has received twelve left boots. The right boots are awaiting separate customs clearance."),
        (channel: Cargo, speaker: "Miner Sato", text: "Reminder: crates marked LIVE SPECIMEN are not seating, even if the seating purrs."),
        (channel: Cargo, speaker: "Miner Sato", text: "The quartermaster's budget meeting has entered its third armed phase."),
        (channel: Cargo, speaker: "Miner Sato", text: "Cargo denies losing the shipment. We know exactly which impossible location it occupies."),
        (channel: Cargo, speaker: "Miner Sato", text: "If anyone ordered six hundred novelty mugs, your purchasing authority has become theoretical."),
        (channel: Cargo, speaker: "Miner Sato", text: "The mail chute is sorting letters by emotional tone. Please write neutrally."),

        (channel: Service, speaker: "Chef Dubois", text: "Today's soup has been downgraded from sentient to merely judgmental."),
        (channel: Service, speaker: "Botanist Ivy", text: "Botany requests the return of a vine answering to Assistant Manager."),
        (channel: Service, speaker: "Chef Dubois", text: "The kitchen fire is under control and has accepted a smaller table."),
        (channel: Service, speaker: "Botanist Ivy", text: "Whoever fertilized the tomatoes with energy drink: they can now see us."),
        (channel: Service, speaker: "Chef Dubois", text: "Dinner service begins at nineteen hundred, assuming dinner remains containable."),
        (channel: Service, speaker: "Botanist Ivy", text: "The ficus in the lobby has been promoted. Address complaints to the ficus."),

        // Second pass of department chatter. Kept comfortably larger than the
        // PA pool below so the fanfare stays an event rather than the station's
        // resting sound.
        (channel: Medical, speaker: "Dr. Vance", text: "Medbay reminder: the phrase 'I looked it up' is not a differential diagnosis."),
        (channel: Medical, speaker: "Nurse Okonkwo", text: "Someone has returned a borrowed scalpel. It is longer than the one we lent out."),
        (channel: Medical, speaker: "Dr. Vance", text: "We have run out of the good bandages and are now issuing the bandages with opinions on you."),
        (channel: Medical, speaker: "Nurse Okonkwo", text: "Bed two would like it noted that he walked in. He would also like a wheelchair."),
        (channel: Medical, speaker: "Dr. Vance", text: "Chemistry, whatever is in the blue bottle, Medical would like more and fewer questions."),

        (channel: Security, speaker: "Officer Reyes", text: "Be advised: a suspect has been apprehended in Maintenance. He was the one who reported it."),
        (channel: Security, speaker: "Warden Bex", text: "The brig has a waiting list. This is not a queue, it is an aspiration."),
        (channel: Security, speaker: "Officer Reyes", text: "Security reminder: contraband stops being contraband the moment I am holding it. Do not test this."),
        (channel: Security, speaker: "Warden Bex", text: "Whoever taught the security camera to follow people dramatically: excellent, never again."),
        (channel: Security, speaker: "Officer Reyes", text: "We have recovered the missing toolbox. It was in Engineering, where it lives, which is the crime."),

        (channel: Engineering, speaker: "Tech Lindqvist", text: "Atmospherics are perfect. I want that on record before anyone opens anything."),
        (channel: Engineering, speaker: "Tech Lindqvist", text: "The lift is working again. It was never broken; it was sulking about the weight limit."),
        (channel: Engineering, speaker: "Tech Lindqvist", text: "Please stop patching the pipes with things that were previously food."),
        (channel: Engineering, speaker: "Tech Lindqvist", text: "Engineering has isolated the smell. Engineering is not going to say where."),
        (channel: Engineering, speaker: "Tech Lindqvist", text: "Reminder: the fuse box is not a light switch, no matter how well that worked yesterday."),

        (channel: Cargo, speaker: "Miner Sato", text: "Cargo has received a crate addressed to 'whoever is brave'. It is available for collection."),
        (channel: Cargo, speaker: "Miner Sato", text: "The requisition backlog is down to nine hundred. Thank you for not looking at it."),
        (channel: Cargo, speaker: "Miner Sato", text: "Whoever ordered a second station: it will not fit, and we are not signing for it."),
        (channel: Cargo, speaker: "Miner Sato", text: "Cargo reminder: 'urgent' is a feeling, not a shipping class."),
        (channel: Cargo, speaker: "Miner Sato", text: "We have located the missing pallet. It has been rebranded as furniture and is doing well."),

        (channel: Service, speaker: "Chef Dubois", text: "The special today is the special from yesterday, rested and much angrier."),
        (channel: Service, speaker: "Botanist Ivy", text: "Botany has grown something the manual describes only as 'do not'."),
        (channel: Service, speaker: "Chef Dubois", text: "Please return the good knife. The kitchen is currently working with the honest knife."),
        (channel: Service, speaker: "Botanist Ivy", text: "The hydroponics tray has started keeping a schedule. It is a better one than mine."),
        (channel: Service, speaker: "Chef Dubois", text: "Service reminds the crew that the bar is self-service, not self-supervising."),

        // ---- Over the PA ---------------------------------------------------
        // `announcement: true` is what fronts a line with the station fanfare
        // instead of a department ident, so it is only ever set on something
        // actually being read to the whole station — never on the Bridge
        // talking to one department, which is what `exchanges` is for.
        (channel: Bridge, speaker: "Duty Officer", announcement: true, text: "Station announcement: morale remains mandatory. Quality remains subject to availability."),
        (channel: Bridge, speaker: "Duty Officer", announcement: true, text: "The owner of a small moon in docking bay two should contact Cargo before it develops tides."),
        (channel: Bridge, speaker: "Duty Officer", announcement: true, text: "Reminder: the emergency exits are for emergencies. Curiosity is no longer categorized as one."),
        (channel: Bridge, speaker: "Duty Officer", announcement: true, text: "Today's evacuation drill is postponed due to an evacuation."),
        (channel: Bridge, speaker: "Duty Officer", announcement: true, text: "Corporate has approved Casual Friday. Pressure suits remain compulsory."),
        (channel: Bridge, speaker: "Duty Officer", announcement: true, text: "The station suggestion box has achieved escape velocity. Suggestions may be shouted upward."),
        (channel: Bridge, speaker: "Duty Officer", announcement: true, text: "All personnel are reminded that 'the AI said it was fine' is not a valid work order."),
        (channel: Bridge, speaker: "Duty Officer", announcement: true, text: "A moment of silence will be observed for the coffee machine, followed by immediate rioting."),
        (channel: Bridge, speaker: "Duty Officer", announcement: true, text: "Unscheduled gravity remains scheduled until further notice."),
        (channel: Bridge, speaker: "Duty Officer", announcement: true, text: "The bridge has reviewed the incident. The incident has declined our findings."),
        (channel: Bridge, speaker: "Duty Officer", announcement: true, text: "Please disregard the previous announcement. If you cannot, report to Medical for selective forgetting."),
        (channel: Bridge, speaker: "Duty Officer", announcement: true, text: "Station clocks are synchronized. Personnel are not."),
        (channel: Bridge, speaker: "Duty Officer", announcement: true, text: "The lost and found has been merged with the evidence locker to reduce walking."),
        (channel: Bridge, speaker: "Duty Officer", announcement: true, text: "Reminder: the airlock cycle is not a ride. Repeat offenders will be issued a longer ride."),
        (channel: Bridge, speaker: "Duty Officer", announcement: true, text: "Hull integrity is nominal. 'Nominal' has been redefined this quarter for your convenience."),
        (channel: Bridge, speaker: "Duty Officer", announcement: true, text: "Would the person storing a live animal in a locker please store a live animal in a different locker."),
        (channel: Bridge, speaker: "Duty Officer", announcement: true, text: "The department of the month is Chemistry, by default, following disqualification of the others."),
        (channel: Bridge, speaker: "Duty Officer", announcement: true, text: "Please do not thank the vending machines. It encourages negotiation."),

        // The Captain is a PA voice only — no walk-in visitor is drawn from
        // this file, so nobody in the lab has to be able to hand them a beaker.
        (channel: Bridge, speaker: "Captain Halloran", announcement: true, text: "This is your captain. I have been informed there is a rumour I am missing. I am not missing. I am delegating."),
        (channel: Bridge, speaker: "Captain Halloran", announcement: true, text: "This is the captain. Whoever moved my chair to Cargo: I found it. I am staying here now."),
        (channel: Bridge, speaker: "Captain Halloran", announcement: true, text: "Captain speaking. Effective immediately, the phrase 'it's fine' requires a second signature."),
        (channel: Bridge, speaker: "Captain Halloran", announcement: true, text: "Crew, this is your captain. Morale is up four percent. We have not identified the cause and are containing it."),
        (channel: Bridge, speaker: "Captain Halloran", announcement: true, text: "This is the captain. Chemistry, whatever you did at oh-nine-hundred, do it again. Nobody knows why the lights are better."),
        (channel: Bridge, speaker: "Captain Halloran", announcement: true, text: "Captain here. I would like to remind everyone that I read every incident report, in the sense that I am aware they exist."),
        (channel: Bridge, speaker: "Captain Halloran", announcement: true, text: "This is your captain, broadcasting from a meeting I am winning."),
        (channel: Bridge, speaker: "Captain Halloran", announcement: true, text: "Captain speaking. Corporate has asked what we are doing about the noise. I have told them we are doing it loudly."),

        // The station AI, which the Bridge would rather it did not have.
        (channel: Bridge, speaker: "Station AI", announcement: true, text: "Attention crew. I have completed a full systems check. I am choosing not to share the results yet."),
        (channel: Bridge, speaker: "Station AI", announcement: true, text: "Reminder from your station AI: I am legally required to announce shift changes and morally free to editorialize."),
        (channel: Bridge, speaker: "Station AI", announcement: true, text: "Attention. Someone has asked me to open a door I do not have. I have opened a different door, for balance."),
        (channel: Bridge, speaker: "Station AI", announcement: true, text: "Announcement: atmospherics are stable in every room where anyone is currently looking."),
        (channel: Bridge, speaker: "Station AI", announcement: true, text: "Crew notice. I have counted you. There are the correct number of you, give or take Cargo."),

        // Corporate, whose bulletins are read out verbatim and against advice.
        (channel: Bridge, speaker: "Corporate Relay", announcement: true, text: "Central Command bulletin: your station has been rated 'operational' by an inspector who did not disembark."),
        (channel: Bridge, speaker: "Corporate Relay", announcement: true, text: "Corporate notice: overtime is now voluntary, mandatory, and unpaid, in that order."),
        (channel: Bridge, speaker: "Corporate Relay", announcement: true, text: "Central Command reminds staff that the company values you at replacement cost plus shipping."),
        (channel: Bridge, speaker: "Corporate Relay", announcement: true, text: "Bulletin: the employee wellness survey results are in and have been sealed for one hundred years."),
        (channel: Bridge, speaker: "Corporate Relay", announcement: true, text: "Corporate advisory: rumours of a bonus are unfounded, unauthorized, and under investigation."),
    ],

    exchanges: [
        (lines: [
            (channel: Engineering, speaker: "Tech Lindqvist", text: "Cargo, did you order a reactor part marked decorative?"),
            (channel: Cargo, speaker: "Miner Sato", text: "No. We ordered a decoration marked reactor part. Different budget."),
        ]),
        (lines: [
            (channel: Medical, speaker: "Dr. Vance", text: "Security, return our defibrillator."),
            (channel: Security, speaker: "Officer Reyes", text: "Negative. It is assisting with an interview."),
        ]),
        (lines: [
            (channel: Service, speaker: "Chef Dubois", text: "Who put a medical scanner in the freezer?"),
            (channel: Medical, speaker: "Nurse Okonkwo", text: "It said the ice cream was terminal. We sought a second opinion."),
        ]),
        (lines: [
            (channel: Cargo, speaker: "Miner Sato", text: "Bridge, our shipment says delivered to 'outside'."),
            (channel: Bridge, speaker: "Duty Officer", text: "Outside is a recognized station-adjacent department."),
        ]),
        (lines: [
            (channel: Security, speaker: "Warden Bex", text: "Engineering, the brig door opens when insulted."),
            (channel: Engineering, speaker: "Tech Lindqvist", text: "Then stop building rapport with it."),
        ]),
        (lines: [
            (channel: Service, speaker: "Botanist Ivy", text: "Medical, can plants experience anxiety?"),
            (channel: Medical, speaker: "Dr. Vance", text: "Only after speaking to Medical."),
        ]),
        (lines: [
            (channel: Medical, speaker: "Nurse Okonkwo", text: "Cargo, why does this crate have a pulse?"),
            (channel: Cargo, speaker: "Miner Sato", text: "Because Procurement rejected the word heartbeat."),
        ]),
        (lines: [
            (channel: Engineering, speaker: "Tech Lindqvist", text: "Service, your oven is drawing reactor-level power."),
            (channel: Service, speaker: "Chef Dubois", text: "Then dinner is ahead of schedule."),
        ]),
        (lines: [
            (channel: Bridge, speaker: "Duty Officer", text: "Security, report on the unidentified noise."),
            (channel: Security, speaker: "Officer Reyes", text: "Noise identified. It objects to the description."),
        ]),
        (lines: [
            (channel: Cargo, speaker: "Miner Sato", text: "Service, your produce requisition lists one hostile melon."),
            (channel: Service, speaker: "Botanist Ivy", text: "That is an assessment, not a quantity."),
        ]),
        (lines: [
            (channel: Bridge, speaker: "Captain Halloran", text: "Engineering, the bridge lights are flickering in a pattern."),
            (channel: Engineering, speaker: "Tech Lindqvist", text: "Yes. Do not reply to it."),
        ]),
        (lines: [
            (channel: Medical, speaker: "Dr. Vance", text: "Chemistry, is there a reason the sample is warm?"),
            (channel: Engineering, speaker: "Tech Lindqvist", text: "There is a reason for everything on this station. That is the problem."),
        ]),
        (lines: [
            (channel: Security, speaker: "Officer Reyes", text: "Cargo, we have a crate here breathing."),
            (channel: Cargo, speaker: "Miner Sato", text: "Then it is alive, which means it is Botany's, which means it is your problem now."),
        ]),
        (lines: [
            (channel: Service, speaker: "Chef Dubois", text: "Bridge, the kitchen requires a ruling. Is soup a beverage."),
            (channel: Bridge, speaker: "Captain Halloran", text: "Not today. Ask me again after the inspection."),
        ]),
        (lines: [
            (channel: Engineering, speaker: "Tech Lindqvist", text: "Medical, quick one — how many fingers is normal."),
            (channel: Medical, speaker: "Nurse Okonkwo", text: "Come to Medbay. Do not bring the wall with you."),
        ]),
        (lines: [
            (channel: Bridge, speaker: "Captain Halloran", text: "Security, status on the thing."),
            (channel: Security, speaker: "Warden Bex", text: "The thing is contained. The thing has a lawyer."),
        ]),
    ],
)
