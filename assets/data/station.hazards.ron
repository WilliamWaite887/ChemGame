// Things that go wrong in the lab on their own, without the chemist's help.
//
// These exist so the medicine cabinet has a reason to be stocked before it is
// needed. Without them the only way to get hurt is to make a mistake, and a
// careful player would never touch a medicine they made.
//
// `grace_seconds` keeps the opening minutes clear: that is where a player
// learns the loop, and a radiation alarm during it reads as the game being
// broken rather than as a hazard.
(
    grace_seconds: 300.0,
    // Never twice at once.
    gap_seconds: (95.0, 190.0),
    // Seconds of radio warning before it starts. Long enough to dose up, short
    // enough to be a scramble.
    warning_seconds: 15.0,
    incidents: [
        (
            id: "rad_leak",
            // Roughly where the radium stock sits, on the dispenser side of the
            // mixing hall.
            spot: "hazard.rad_leak",
            radius: 4.5,
            duration: 40.0,
            warning: "Radiation alarm on the chem lab sensor. Dose up or clear the area.",
            onset: "The counter by the dispenser starts clicking.",
            // Intensity of the Irradiated status applied per metabolism tick to
            // anyone inside the radius. Hyronalin counters 1.0 per tick and
            // arithrazine 3.0, so standing in it costs you a steady drip of one
            // or the other.
            intensity: 2.0,
            // Sickly green, matching the screen flash `fx` already gives an
            // irradiated chemist, so the sphere and the symptom read as the
            // same event.
            color: (0.45, 0.95, 0.35),
            // The one incident that trips the lab's rad klaxon, which runs for
            // as long as the leak does.
            radiological: true,
        ),
        (
            id: "coolant_vent",
            // In the reaction bay, by the chamber. The bay's walls do not stop
            // the radius — it is a sphere, not a room — but the chamber is far
            // enough into its own room that the hall stays clear, so a vent is
            // now a reason to leave the bay rather than to leave the lab.
            spot: "hazard.coolant_vent",
            radius: 3.5,
            duration: 30.0,
            warning: "Atmos here — we've got a coolant line weeping near your chamber.",
            onset: "The air by the reaction chamber turns sharp and cold.",
            intensity: 1.0,
            // Cold blue-white, so a vent is never mistaken for the rad leak at
            // a glance across the hall.
            color: (0.55, 0.80, 1.0),
            // Stated rather than defaulted: a vent still hurts you, and the
            // reason it is silent is that it is not radiation, not oversight.
            radiological: false,
        ),
    ],
)
