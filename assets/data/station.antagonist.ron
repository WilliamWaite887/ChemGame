// The hidden antagonist thread.
//
// Every entry here is a crew visit indistinguishable from a legitimate one —
// same roster, same walk to the counter, same queue slot. `pretext` asks for
// the reagent by its real name, wrapped in an excuse ordinary enough to pass
// unremarked. `incident_line` is the only tell: an unrelated-sounding piece
// of station news naming the same reagent, aired independently of the visit
// by `antagonist::generate_antagonist_orders`. `chaos_line` is the delayed
// report of what happened if you actually gave it to them.
//
// Nothing here is ever listed in `station.orders.ron` — these requests only
// ever come from this file, through their own generator, on their own much
// rarer clock.
(
    // Multiplied onto whatever the *current* legitimate order gap is, rather
    // than a flat range — so an antagonist visit keeps pace with the ramp
    // instead of staying at a fixed cadence while legitimate orders arrive
    // faster and faster. At tier 0 (legit gap 32-58s) this lands close to
    // the old flat 240-420s range; at the ramp's floor (legit gap 18s) it
    // tightens to roughly 108-180s.
    gap_multiplier: (6.0, 10.0),
    // Matches crisis.ron's own `underworld_threshold` by content convention,
    // not by code coupling — see `AntagonistScript::standing_tighten_at`.
    standing_tighten_at: 8,
    requests: [
        (
            reagent: "sonic_powder", amounts: [9, 12], role: "Security",
            pretext: "Need Sonic Powder for a hearing-protection calibration. Keep the batch stabilized.",
            incident_line: "A concussive pulse in maintenance left two witnesses unable to hear and barely able to stand.",
            chaos_line: "The calibration powder was heated in a crowded checkpoint. Security never authorized the trial.",
            min_standing: 4, sting_chance: 0.10,
        ),
        (
            reagent: "sorium", amounts: [12, 16], role: "Cargo",
            pretext: "Need stabilized Sorium for a freight-cradle repulsion test.",
            incident_line: "A pressure pulse threw a cargo patrol away from an opened secure crate.",
            chaos_line: "The freight test cleared the room, not the jam. High-value cargo disappeared during the confusion.",
            min_standing: 6, sting_chance: 0.15,
        ),
        (
            reagent: "liquid_dark_matter", amounts: [9, 12], role: "Engineering",
            pretext: "Liquid Dark Matter recovery sample. Engineering need to pull a tool out of a sealed conduit.",
            incident_line: "An attraction pulse dragged a patrol into an ambush at a maintenance junction.",
            chaos_line: "The recovery sample pulled loose equipment and three people into the same sabotaged compartment.",
            min_standing: 10, sting_chance: 0.25,
        ),
        (
            reagent: "gunpowder", amounts: [20, 30], role: "Engineering",
            pretext: "Need Gunpowder for an actuator test. Engineering signed it off.",
            incident_line: "Security found scorched actuator parts in an unassigned maintenance bay.",
            chaos_line: "A maintenance door was blown inward. Engineering deny ordering any propellant.",
            min_standing: 2,
        ),
        (
            reagent: "nitroglycerin", amounts: [8, 12], role: "Cargo",
            pretext: "Need a stabilized Nitroglycerin sample for mineral assay calibration.",
            incident_line: "Cargo cleared a corridor after finding a sweating bottle wired under a crate.",
            chaos_line: "The cargo lock is gone and so is half the high-value shipment.",
            min_standing: 6, sting_chance: 0.15,
        ),
        (
            reagent: "rdx", amounts: [8, 12], role: "Security",
            pretext: "Authorized RDX evidence sample. Do not log it at the public counter.",
            incident_line: "Command reports a precision breach in a restricted compartment.",
            chaos_line: "Someone used a compact charge on the armory access and knew exactly where to place it.",
            min_standing: 10, sting_chance: 0.25,
        ),
        (
            reagent: "teslium", amounts: [9, 12], role: "Engineering",
            pretext: "Teslium insulation standard for a maintenance breaker test. Keep it dry.",
            incident_line: "A wet electrical charge arced through a maintenance checkpoint and dropped its equipment offline.",
            chaos_line: "The breaker test disabled the checkpoint long enough for someone to cross the sealed corridor.",
            min_standing: 10, sting_chance: 0.25,
        ),
        (
            reagent: "tatp", amounts: [5, 8], role: "Security",
            pretext: "TaTP trace standard for explosive-residue analyzer certification.",
            incident_line: "Security found a compact expert charge warming behind a restricted airlock.",
            chaos_line: "The analyzer standard became a precision breach charge. Security never authorized its release.",
            min_standing: 14, sting_chance: 0.40,
        ),
        (
            reagent: "pax", amounts: [5, 10], role: "Security",
            pretext: "Pax standard for nonlethal hostile-subject restraint certification.",
            incident_line: "A patrol stopped pursuing an intruder after an unlogged pacification exposure.",
            chaos_line: "The restraint standard pacified the response team instead of the suspect. The secure route was left undefended.",
            min_standing: 12, sting_chance: 0.30,
        ),
        (
            reagent: "space_drugs",
            // Overdoses at 20u, but the recipe yields in multiples of 3 —
            // 20 itself can never be made exactly. See the note on
            // "station.orders.ron" for the general case.
            amounts: [15, 18],
            role: "Service",
            pretext: "Could I get some Space Drugs? It's for the bar someone asked, I didn't ask why.",
            incident_line: "Security log: a crewman was seen glassy-eyed and giggling near the bar, no idea why.",
            chaos_line: "Whatever's been going around the bar has three people missing their shift now.",
        ),
        (
            reagent: "bath_salts",
            amounts: [10, 15],
            role: "Security",
            pretext: "Need some Bath Salts logged into evidence storage. Paperwork's already filed.",
            incident_line: "Engineering reports someone tore a support panel off the wall with their bare hands.",
            chaos_line: "That 'evidence' never made it to storage — two more crew came in twitching since.",
            // A Spy-flavoured deal: getting caught here is one bad handoff,
            // not accumulated suspicion.
            sting_chance: 0.2,
        ),
        (
            reagent: "krokodil",
            amounts: [10, 15],
            role: "Medical",
            pretext: "Could you mix up some Krokodil? Doctor's orders, for a research sample.",
            incident_line: "Janitorial found a patch of scorched, blistered flooring outside the medbay backroom.",
            chaos_line: "Someone's arm looks like it's rotting from the inside. Medbay's asking where the Krokodil went.",
            // A bolder ask — only surfaces once the underworld already
            // trusts you a little.
            min_standing: 4,
        ),
        (
            reagent: "methamphetamine",
            // Overdoses at 10u, but the recipe yields in multiples of 3 —
            // 10 itself can never be made exactly. See the note on
            // "station.orders.ron" for the general case.
            amounts: [8, 9],
            role: "Engineering",
            pretext: "Any chance of some Methamphetamine? Double shift, need to stay sharp on the reactor.",
            incident_line: "Atmos flagged someone pacing the same corridor for forty minutes, talking to no one.",
            chaos_line: "Engineering's had someone rewiring conduits that were never broken. Hasn't slept in two shifts.",
        ),
        (
            reagent: "mindbreaker_toxin",
            // Overdoses at 12u.
            amounts: [10, 12],
            role: "Cargo",
            pretext: "Could you whip up some Mindbreaker Toxin? Testing pest deterrents on the shipment.",
            incident_line: "Someone in the cargo bay swears the crates were whispering to them.",
            chaos_line: "Cargo's short a crewman — last seen arguing with a wall about the shipping manifest.",
        ),
        (
            reagent: "zombie_powder",
            // Overdoses at 10u, but the recipe yields in multiples of 3 —
            // 10 itself can never be made exactly. See the note on
            // "station.orders.ron" for the general case.
            amounts: [8, 9],
            role: "Security",
            pretext: "I need some Zombie Powder for a restraint procedure. Nothing to worry about.",
            incident_line: "A crewman collapsed mid-sentence in the hallway — breathing, but unresponsive.",
            chaos_line: "That's the second crewman found frozen stiff this shift. Whoever's handing out Zombie Powder needs to stop.",
            // The boldest ask in the roster — only once the underworld
            // trusts you a lot.
            min_standing: 6,
            sting_chance: 0.15,
        ),
        (
            reagent: "kronkaine", amounts: [12, 18], role: "Cargo",
            pretext: "Botany sent a Kronkaine performance sample for courier endurance trials.",
            incident_line: "Cargo reports a runner crossing three decks without stopping, then collapsing beside the lift.",
            chaos_line: "That endurance trial was never authorized. Medical is treating acute stimulant strain.",
            min_standing: 6, sting_chance: 0.15,
        ),
        (
            reagent: "blastoff", amounts: [15, 20], role: "Service",
            pretext: "Need bLaSToFF for a zero-gravity entertainment effects test.",
            incident_line: "Service shut a lounge after someone repeatedly launched themselves across the room.",
            chaos_line: "The lounge test ended with three broken tables and a very angry atmospheric technician.",
            min_standing: 4,
        ),
        (
            reagent: "saturn_x", amounts: [12, 16], role: "Security",
            pretext: "SaturnX visibility standard. Evidence needs a calibrated reference batch.",
            incident_line: "Security cameras lost a moving silhouette near a restricted maintenance junction.",
            chaos_line: "The reference batch vanished with its courier. So did the contents of a secure locker.",
            min_standing: 8, sting_chance: 0.25,
        ),
        (
            reagent: "mute_toxin", amounts: [10, 14], role: "Security",
            pretext: "Mute Toxin calibration standard. Communications is testing emergency witness protocols.",
            incident_line: "Security found an assault victim unable to make a radio report until a passerby intervened.",
            chaos_line: "The calibration sample was used to silence a witness in maintenance. The authorization was forged.",
            min_standing: 2, sting_chance: 0.15,
        ),
        (
            reagent: "heparin", amounts: [10, 15], role: "Medical",
            pretext: "Need Heparin for analyzer calibration against an injured-patient sample.",
            incident_line: "Medical is investigating an injured patient whose condition worsened after an unlogged injection.",
            chaos_line: "That calibration batch reached a trauma patient. Their bleeding symptoms escalated immediately.",
            min_standing: 4,
        ),
        (
            reagent: "amanitin", amounts: [8, 10], role: "Service",
            pretext: "Need an Amanitin fungal standard for kitchen forage-screen calibration.",
            incident_line: "A crew member collapsed from delayed toxin exposure long after leaving the galley.",
            chaos_line: "The forage screen passed a lethal mushroom sample. Service insists nobody authorized the test.",
            min_standing: 6,
        ),
        (
            reagent: "curare", amounts: [5, 8], role: "Cargo",
            pretext: "Need Curare for a wildlife-restraint shipment assay before unloading.",
            incident_line: "A cargo handler was found breathing poorly and unable to move beside an opened wildlife crate.",
            chaos_line: "The restraint assay disappeared, and a courier was silently taken down near secure freight.",
            min_standing: 8, sting_chance: 0.20,
        ),
        (
            reagent: "lexorin", amounts: [5, 8], role: "Medical",
            pretext: "Lexorin respiratory-drill standard. We need to verify the Epinephrine response window.",
            incident_line: "Medical treated sudden respiratory failure with an emergency Epinephrine purge.",
            chaos_line: "The drill standard was used outside medbay. One victim survived only because Epinephrine was ready.",
            min_standing: 8, sting_chance: 0.25,
        ),
        (
            reagent: "tirizene", amounts: [12, 18], role: "Service",
            pretext: "Death Berry Tirizene standard for food-screen sensitivity testing.",
            incident_line: "Service reports several crew suddenly moving as if exhausted after sharing unmarked fruit.",
            chaos_line: "The food-screen sample was diluted into drinks. Nobody is badly hurt, but half the lounge can barely keep pace.",
            min_standing: 2,
        ),
        (
            reagent: "tiring_solution", amounts: [12, 18], role: "Security",
            pretext: "Need Tiring Solution for a nonlethal restraint-dose certification.",
            incident_line: "Security found a restraint vial missing after a suspect escaped at walking speed.",
            chaos_line: "The certification batch was used on a patrol team. They remained conscious but could not catch the courier.",
            min_standing: 4, sting_chance: 0.15,
        ),
        (
            reagent: "sodium_thiopental", amounts: [8, 12], role: "Medical",
            pretext: "Sodium Thiopental reference batch for prolonged-sedation monitoring.",
            incident_line: "Medical received an unconscious crew member with no injury and an unlogged sedative in their blood.",
            chaos_line: "The monitoring batch became an interrogation dose. The patient is alive, deeply sedated, and missing several hours.",
            min_standing: 6,
        ),
        (
            reagent: "pancuronium", amounts: [5, 8], role: "Security",
            pretext: "Pancuronium standard for respirator readiness and delayed-restraint drills.",
            incident_line: "A security drill ended when an officer stopped moving and began struggling to breathe ten cycles after exposure.",
            chaos_line: "The delayed-restraint batch was used without a respirator team present. Medical is treating severe paralysis.",
            min_standing: 8, sting_chance: 0.20,
        ),
        (
            reagent: "initropidril", amounts: [5, 8], role: "Medical",
            pretext: "Initropidril cardiotoxicity control for emergency defibrillation calibration.",
            incident_line: "Medical reports a rapid toxin case that progressed into respiratory collapse before the monitor alarmed.",
            chaos_line: "The cardiotoxicity control was injected outside the drill. The victim collapsed before reaching medbay.",
            min_standing: 10, sting_chance: 0.25,
        ),
        (
            reagent: "tetrodotoxin", amounts: [5, 8], role: "Cargo",
            pretext: "Tetrodotoxin assay from a quarantined pufferfish specimen. Xenobiology needs a clean reference.",
            incident_line: "Cargo quarantined a specimen crate after a handler's tongue swelled and paralysis followed minutes later.",
            chaos_line: "The clean reference vanished into an air injector. Its victim had a warning phase, then catastrophic respiratory failure.",
            min_standing: 10, sting_chance: 0.30,
        ),
        (
            reagent: "amatoxin", amounts: [8, 12], role: "Service",
            pretext: "Need an Amatoxin reference from Fly Amanita for forage-screen discrimination testing.",
            incident_line: "Service cleared a bright mushroom sample that produced steady toxin damage after the meal.",
            chaos_line: "The forage reference was served as garnish. Medical is purging a persistent toxin from several diners.",
            min_standing: 4,
        ),
        (
            reagent: "coniine", amounts: [5, 8], role: "Service",
            pretext: "Coniine standard requested for Death Berry respiratory-hazard calibration.",
            incident_line: "A botanical assay left its handler steadily poisoned and struggling for breath long after exposure.",
            chaos_line: "The Death Berry standard entered the ventilation tasting booth. Its unusually slow clearance has tied up Medical.",
            min_standing: 6, sting_chance: 0.15,
        ),
        (
            reagent: "histamine", amounts: [10, 15], role: "Medical",
            pretext: "Histamine control needed for an Omega Weed allergy and overdose-response trial.",
            incident_line: "An allergy trial crossed its dose ceiling, causing blurred vision and widespread systemic damage.",
            chaos_line: "The irritant control was concentrated above thirty units. The patient now has simultaneous trauma, toxin, and oxygen injury.",
            min_standing: 6, sting_chance: 0.15,
        ),
        (
            reagent: "polonium", amounts: [5, 8], role: "Engineering",
            pretext: "Polonium isotope standard requested for radiation-medicine endurance calibration.",
            incident_line: "A calibration subject developed intense persistent irradiation from an unshielded isotope sample.",
            chaos_line: "The isotope standard disappeared before chelation trials. Medical is searching for a victim with a radiation analyzer.",
            min_standing: 12, sting_chance: 0.35,
        ),
        (
            reagent: "fentanyl", amounts: [5, 8], role: "Medical",
            pretext: "Fentanyl standard needed for delayed-opiate collapse and Naloxone treatment training.",
            incident_line: "An opiate exercise ended in delayed unconsciousness eighteen cycles after the monitor first showed exposure.",
            chaos_line: "The concentrated opiate standard was substituted for routine analgesic. Medical is treating both collapse and dependence.",
            min_standing: 12, sting_chance: 0.35,
        ),
        (
            reagent: "bungotoxin", amounts: [5, 8], role: "Service",
            pretext: "Bungotoxin reference needed for a twelve-cycle cardiotoxic forage drill.",
            incident_line: "A Bungo Fruit assay progressed from mixed poisoning to fainting and severe breath loss.",
            chaos_line: "The forage standard reached the dining room. Medical is timing the predictable twelve-cycle collapse window.",
            min_standing: 8, sting_chance: 0.20,
        ),
        (
            reagent: "lead_acetate", amounts: [8, 12], role: "Engineering",
            pretext: "Lead Acetate control requested for heavy-metal sensory damage calibration.",
            incident_line: "An unlogged heavy-metal sample caused simultaneous trauma, toxin damage, and blurred perception.",
            chaos_line: "The calibration control was hidden in a drink bottle. Engineering denies authorizing a human exposure.",
            min_standing: 8, sting_chance: 0.20,
        ),
        (
            reagent: "venom", amounts: [8, 12], role: "Cargo",
            pretext: "Giant Spider Venom concentration standard required before specimen quarantine release.",
            incident_line: "A specimen handler's injuries worsened in direct proportion to the venom still circulating.",
            chaos_line: "The concentrated spider extract vanished from quarantine. Every unit not yet purged is compounding the victim's injuries.",
            min_standing: 10, sting_chance: 0.25,
        ),
        (
            reagent: "itching_powder", amounts: [10, 15], role: "Service",
            pretext: "Itching Powder requested for protective-clothing splash penetration testing.",
            incident_line: "A contact trial caused persistent scratching injuries and motor distraction through a splash exposure.",
            chaos_line: "The irritant standard was loaded into a sprayer. Service is treating minor trauma across the public corridor.",
            min_standing: 8, sting_chance: 0.20,
        ),
        (
            reagent: "rotatium", amounts: [5, 8], role: "Medical",
            pretext: "Rotatium standard needed for delayed vestibular-distortion countermeasure testing.",
            incident_line: "A patient developed violent visual rocking and motor distortion twenty cycles after a complex exposure.",
            chaos_line: "The expert perception toxin was dosed before the monitor could name it. The delayed distortion has now begun.",
            min_standing: 14, sting_chance: 0.40,
        ),
    ],

    // The illicit shop, fully hidden — no panel, no visible number, ever.
    // One per department, the same `role`-keyed drawing a request already
    // uses, so a department with one roster member (Cargo, Engineering)
    // resolves to that one person for free. No `incident_line`/`chaos_line`/
    // `sting_chance`: a private purchase has no fictional reason to make
    // noise the way fulfilling someone else's request does.
    offer_chance: 0.35,
    offers: [
        (
            reagent: "bath_salts", amounts: [6, 10], role: "Cargo",
            pretext: "Got a spare batch riding along with the last shipment, if you're interested.",
            min_standing: 4, cost: 4,
        ),
        (
            reagent: "maintenance_tar", amounts: [8, 12], role: "Engineering",
            pretext: "There's maintenance tar left over from the last job — yours if you want it.",
            min_standing: 4, cost: 4,
        ),
        (
            reagent: "fentanyl", amounts: [4, 6], role: "Medical",
            pretext: "A few diverted units, off the books, if that's useful to you.",
            min_standing: 6, cost: 5,
        ),
        (
            reagent: "saturn_x", amounts: [8, 12], role: "Security",
            pretext: "Confiscated stock that never made it into evidence. Yours, quietly.",
            min_standing: 8, cost: 6,
        ),
        (
            reagent: "blastoff", amounts: [10, 15], role: "Service",
            pretext: "Someone left a stash behind the bar. Want it before it's noticed?",
            min_standing: 4, cost: 4,
        ),
    ],
)
