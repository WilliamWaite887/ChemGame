// Order generation and the requests crew can make.
//
// `amounts` are the quantities a requester might ask for, in units. Keep them
// achievable with one or two beakers — an order nobody can physically carry is
// just a guaranteed failure.
//
// The numbers below are tier 0 — a brand new career. Everything in `ramp`
// tightens them as `succeeded + botched` climbs; `ShiftRules::for_tier` is
// where that arithmetic lives, and `tier_zero_matches_the_base_config`
// guarantees the ramp is a no-op here.
(
    first_order_delay: 8.0,
    gap_seconds: (32.0, 58.0),
    patience_seconds: (135.0, 230.0),
    max_active: 3,

    // How much rarer an "asks for it by name" order is than an ordinary
    // lenient one, multiplied onto the *current* legitimate gap above —
    // matches `station.antagonist.ron`'s own `gap_multiplier` by default, so
    // an honest specific ask happens exactly as often as an illicit one.
    specific_gap_multiplier: (6.0, 10.0),

    // How often the station briefing redraws. There is no shift boundary to
    // redraw it against any more — crew arrive continuously — so this is its
    // own clock.
    forecast_seconds: (180.0, 300.0),

    // How much harder the lab gets as the career goes on. Every value is
    // clamped: an unclamped ramp is only unplayable somewhere nobody tests.
    ramp: (
        orders_per_tier: 5,
        gap_scale: 0.92,
        gap_floor: 18.0,
        patience_scale: 0.95,
        patience_floor: 80.0,
        max_active_every: 2,
        max_active_cap: 5,
        // Optional development requests preview at most one equipment tier
        // and one unknown reaction ahead. They start only after the opening
        // tutorial run, never stack, wait longer, and cost just one standing
        // (not a botch) when ignored.
        stretch_base: 0.12,
        stretch_step: 0.01,
        stretch_cap: 0.22,
        stretch_after_successes: 5,
        stretch_patience_scale: 1.5,
        stretch_expiry_standing: -1,
        forecast_boost: 2.0,

        // Team-size scaling, layered on top of the tier ramp above rather
        // than replacing it — see `shift::scale_for_chemists`. Solo
        // (one chemist) is a mathematical no-op by construction: these three
        // are tuned around a 30-second advanced batch: roughly 67% useful
        // load solo and 77% per player at a four-person table.
        chemist_gap_scale: 0.60,
        max_active_per_chemist: 1,
        max_active_chemist_cap: 3,
    ),

    // Cargo tops the lab up to `glassware_target` on a periodic check.
    // Beakers leave with whoever they were handed to and nothing else makes
    // them, so without this the lab runs dry after five deliveries.
    supply: (
        courier: "Miner Sato",
        glassware_target: 6,
        crate_max: 4,
        large_every: 3,
        requisition_glassware_bonus: 2,
    ),

    // What the station expects, briefed periodically over the radio. A
    // forecast leans the request pool toward its themes — it never chooses
    // for it, so a stretch you are unprepared for is still one you can work.
    forecasts: [
        (
            id: "hull_plate",
            themes: ["burns"],
            weight: 1.0,
            briefing: "Engineering are cutting hull plate all shift. Expect burns.",
        ),
        (
            id: "breach_drill",
            themes: ["asphyxiation", "trauma"],
            weight: 1.0,
            briefing: "Breach drill on deck two. Asphyxiation cases, maybe worse.",
        ),
        (
            id: "containment",
            themes: ["radiation"],
            weight: 0.8,
            briefing: "Atmos flagged a leaking containment cell. Watch for rad exposure.",
        ),
        (
            id: "bar_night",
            themes: ["poison"],
            weight: 1.0,
            briefing: "Payday, and the bar is heaving. You know how that ends.",
        ),
        (
            id: "sparring",
            themes: ["trauma"],
            weight: 0.9,
            briefing: "Security are running takedown drills. Bruises and worse.",
        ),
        (
            id: "takedown_drills",
            themes: ["concussion", "trauma"],
            weight: 0.8,
            briefing: "Security are running headgear-optional takedown drills. Expect heads to be rung.",
        ),
        (
            id: "quiet",
            themes: [],
            weight: 0.6,
            briefing: "Nothing on the board. Should be a quiet one — use it.",
        ),
    ],

    // `reagent` is still what each request is authored around — it decides
    // the category the request actually requires (see
    // `orders::reference_category`) and gates reachability. `plea` no longer
    // names it: a legitimate order now describes the problem, not the cure,
    // and accepts any chemical that treats the same category — deliver a
    // better one than whatever's implied here and it earns more department
    // favor (see `Reagent::potency`). `specific_plea` is what the same
    // request says on the rare occasions it is drawn as an exact ask instead
    // — see `orders::generate_specific_orders`.
    //
    // `amounts` must stay at or under the reagent's own `overdose` threshold
    // in `chem.reagents.ron`. Above it there is no delivery that works: a
    // pill, bottle or syringe of exactly what was asked for grades `Overdose`
    // and anything smaller grades `Short`, leaving a beaker as the only
    // container that ever passes and nothing on screen saying why. Pinned by
    // `no_request_asks_for_more_than_can_be_safely_handed_over`, and clamped
    // at spawn by `orders::deliverable_amount` for anything that slips
    // through anyway.
    requests: [
        (
            reagent: "firefighting_foam",
            amounts: [12, 18],
            plea: "Engineering need a non-slip cooling blanket for a live plasma-fire exercise.",
            specific_plea: "Engineering specifically require Firefighting Foam kept below its 310K synthesis ceiling.",
            themes: ["engineering", "fire"], minimum_successes: 20, exact: true, minimum_purity: 0.75, patience_scale: 1.5,
        ),
        (
            reagent: "chemical_foam",
            amounts: [10, 16],
            plea: "Janitorial need an expanding carrier for a controlled corridor decontamination trial.",
            specific_plea: "Janitorial specifically require clean Chemical Foam for a mixture-carriage test.",
            themes: ["service", "cleaning"], minimum_successes: 25, exact: true, minimum_purity: 0.80, patience_scale: 1.6,
        ),
        (
            reagent: "metal_foam",
            amounts: [8, 12],
            plea: "Engineering need a temporary lightweight barrier to isolate a damaged service conduit.",
            specific_plea: "Engineering specifically require Metal Foam for a thirty-six-second containment test.",
            themes: ["engineering", "containment"], minimum_successes: 40, exact: true, minimum_purity: 0.85, patience_scale: 1.8,
        ),
        (
            reagent: "carbon_dioxide",
            amounts: [12, 18],
            plea: "Atmospherics need a liquid fire-suppression charge for a fuel-line isolation drill.",
            specific_plea: "Atmospherics specifically require clean Carbon Dioxide synthesized above 777K.",
            themes: ["engineering", "fire"], minimum_successes: 45, exact: true, minimum_purity: 0.85, patience_scale: 1.9,
        ),
        (
            reagent: "pax",
            amounts: [5, 10],
            plea: "Security medical need a controlled non-sedating pacifier for a hostile-subject response exercise.",
            specific_plea: "Security medical specifically require Pax that can stop hostile pursuit without incapacitating the subject.",
            themes: ["security", "containment"], minimum_successes: 55, exact: true, minimum_purity: 0.90, patience_scale: 2.0,
        ),
        (
            reagent: "pyrosium",
            amounts: [15, 21],
            plea: "Engineering need a reusable thermal catalyst for an emergency cold-start test.",
            specific_plea: "Engineering specifically require Pyrosium for a controlled liquid-Oxygen heating test.",
            themes: ["engineering", "temperature"], minimum_successes: 20, exact: true, minimum_purity: 0.75, patience_scale: 1.4,
        ),
        (
            reagent: "sonic_powder",
            amounts: [9, 12],
            plea: "Security need a stabilized concussive agent for a hearing-protection and crowd-warning drill.",
            specific_plea: "Security specifically require stabilized Sonic Powder for a 374K activation trial.",
            themes: ["concussion", "security"], minimum_successes: 25, exact: true, minimum_purity: 0.80, patience_scale: 1.5,
        ),
        (
            reagent: "sorium",
            amounts: [12, 16],
            plea: "Cargo need a radial repulsion agent to clear a jammed automated freight cradle.",
            specific_plea: "Cargo specifically require stabilized Sorium for a controlled 474K repulsion test.",
            themes: ["engineering", "cargo"], minimum_successes: 30, exact: true, minimum_purity: 0.80, patience_scale: 1.6,
        ),
        (
            reagent: "liquid_dark_matter",
            amounts: [9, 12],
            plea: "Engineering need a compact attraction agent to recover loose hardware from an inaccessible compartment.",
            specific_plea: "Engineering specifically require stabilized Liquid Dark Matter for a controlled 474K recovery pulse.",
            themes: ["engineering", "recovery"], minimum_successes: 45, exact: true, minimum_purity: 0.90, patience_scale: 1.9,
        ),
        (
            reagent: "gunpowder",
            amounts: [20, 30],
            plea: "Engineering need a controlled propellant batch for a sealed-door drill.",
            specific_plea: "Engineering need gunpowder for a sealed-door drill. Package and handle it carefully.",
            themes: ["demolition", "breach"], minimum_successes: 15, exact: true, minimum_purity: 0.75, patience_scale: 1.5,
        ),
        (
            reagent: "nitroglycerin",
            amounts: [8, 12],
            plea: "Emergency demolition need a compact energetic charge for a trapped compartment.",
            specific_plea: "Emergency demolition need stabilized nitroglycerin for a trapped compartment.",
            themes: ["demolition", "breach"], minimum_successes: 30, exact: true, minimum_purity: 0.85, patience_scale: 1.75,
        ),
        (
            reagent: "rdx",
            amounts: [8, 12],
            plea: "Command authorized a precision breach. They need the strongest compact explosive you can make.",
            specific_plea: "Command authorized a precision breach and specifically require RDX.",
            themes: ["demolition", "breach"], minimum_successes: 45, exact: true, minimum_purity: 0.90, patience_scale: 2.0,
        ),
        (
            reagent: "teslium",
            amounts: [9, 12],
            plea: "Engineering need a clean conductive charge for a remote breaker and insulation trial.",
            specific_plea: "Engineering specifically require Teslium kept dry and below its 474K arc threshold.",
            themes: ["engineering", "electrical"], minimum_successes: 40, exact: true, minimum_purity: 0.85, patience_scale: 1.8,
        ),
        (
            reagent: "tatp",
            amounts: [5, 8],
            plea: "Command authorized an expert micro-breach where a larger charge would damage critical structure.",
            specific_plea: "Command specifically require high-purity TaTP stabilized through its synthesis window and kept below 550K.",
            themes: ["demolition", "breach"], minimum_successes: 65, minimum_recipes_known: 28, exact: true, minimum_purity: 0.95, patience_scale: 2.3,
        ),
        (
            reagent: "libital",
            amounts: [12, 16, 20],
            plea: "Medical need a clean advanced trauma batch for patients who cannot tolerate contaminants.",
            specific_plea: "Medical require Libital at no less than eighty-five percent purity.",
            themes: ["trauma"], minimum_successes: 30, exact: true, minimum_purity: 0.85, patience_scale: 1.5,
        ),
        (
            // The mastery quality check. Lenturi's four-part synthesis is
            // useful before this appears; at 95% the player must also use the
            // analyzer's HPLC program and account for its yield loss.
            reagent: "lenturi",
            amounts: [12, 16, 20, 24],
            plea: "Medical need a chromatography-grade superior burn treatment for a critical graft case.",
            specific_plea: "Medical require Lenturi at no less than ninety-five percent purity.",
            themes: ["burns"], minimum_successes: 60, minimum_recipes_known: 24, exact: true, minimum_purity: 0.95, patience_scale: 2.25,
        ),
        (
            reagent: "granibitaluri",
            amounts: [15, 24, 30],
            plea: "Medical need a steady mixed-injury treatment for a workshop accident.",
            specific_plea: "Medical specifically request Granibitaluri for a mixed-injury observation trial.",
            themes: ["trauma", "burns"], minimum_successes: 12, patience_scale: 1.25,
        ),
        (
            reagent: "rezadone",
            amounts: [12, 18, 24],
            plea: "Medical have a badly burned casualty with extensive physical trauma and need one superior restorative batch.",
            specific_plea: "Medical specifically require clean Rezadone for a combined trauma and burn case.",
            themes: ["trauma", "burns"], minimum_successes: 30, exact: true, minimum_purity: 0.80, patience_scale: 1.6,
        ),
        (
            reagent: "oculine",
            amounts: [9, 12, 15],
            plea: "Medical have a chemically blinded technician who needs specialist vision care.",
            specific_plea: "Medical specifically require Oculine for a chemically blinded technician.",
            themes: ["concussion"], minimum_successes: 20, exact: true, minimum_purity: 0.70, patience_scale: 1.4,
        ),
        (
            reagent: "diphenhydramine",
            amounts: [8, 12, 16, 20, 24],
            plea: "Medical need a sedating counteragent for a severe stimulant reaction.",
            specific_plea: "Medical specifically require Diphenhydramine for a severe stimulant reaction.",
            themes: ["poison"], minimum_successes: 25, exact: true, minimum_purity: 0.75, patience_scale: 1.5,
        ),
        (
            reagent: "antihol",
            amounts: [12, 18],
            plea: "Medical are treating severe alcohol poisoning after the bar rush and need a fast purge.",
            specific_plea: "Medical specifically require Antihol for a severe alcohol poisoning case.",
            themes: ["poison"], minimum_successes: 20, exact: true, minimum_purity: 0.70, patience_scale: 1.4,
        ),
        (
            reagent: "modafinil",
            amounts: [10, 15, 20],
            plea: "Medical have a chemically sedated responder who needs to wake cleanly without another crash.",
            specific_plea: "Medical specifically require Modafinil for a chemically sedated responder.",
            themes: ["concussion"], minimum_successes: 30, exact: true, minimum_purity: 0.80, patience_scale: 1.7,
        ),
        (
            reagent: "naloxone",
            amounts: [8, 12, 16],
            plea: "Medical have an opioid overdose losing consciousness and breathing capacity despite supportive care.",
            specific_plea: "Medical specifically require clean Naloxone for an opioid overdose.",
            themes: ["poison"], minimum_successes: 25, exact: true, minimum_purity: 0.75, patience_scale: 1.55,
        ),
        (
            reagent: "hercuri",
            amounts: [10, 15, 20],
            plea: "Medical have burn casualties still reigniting after a machinery fire and need a cold suppressant batch.",
            specific_plea: "Medical specifically require clean Hercuri for burn casualties who are still reigniting.",
            themes: ["burns"], minimum_successes: 35, exact: true, minimum_purity: 0.80, patience_scale: 1.75,
        ),
        (
            reagent: "syriniver",
            amounts: [5],
            plea: "Toxicology need a precise concentrate for an aggressive diluted blood purge; excess stock is unsafe.",
            specific_plea: "Toxicology specifically require one five-unit batch of clean Syriniver concentrate for dilution.",
            themes: ["poison"], minimum_successes: 40, exact: true, minimum_purity: 0.85, patience_scale: 1.9,
        ),
        (
            reagent: "pyroxadone",
            amounts: [9, 12, 15],
            plea: "Medical are preparing a controlled combustion ward for catastrophic mixed trauma and need expert recovery stock.",
            specific_plea: "Medical specifically require high-purity Pyroxadone for a controlled combustion treatment.",
            themes: ["trauma", "burns"], minimum_successes: 55, exact: true, minimum_purity: 0.90, patience_scale: 2.1,
        ),
        (
            reagent: "regenerative_jelly",
            amounts: [8, 12, 16],
            plea: "Medical have a multi-system casualty who needs a purified biological restorative rather than four separate drips.",
            specific_plea: "Medical specifically require Regenerative Jelly at no less than ninety-five percent purity.",
            themes: ["trauma", "burns", "poison"], minimum_successes: 65, minimum_recipes_known: 24, exact: true, minimum_purity: 0.95, patience_scale: 2.2,
        ),
        (
            reagent: "penthrite",
            amounts: [9, 12, 15],
            plea: "Emergency Medical have a critically injured multi-system casualty and need a controlled explosive vasodilator prepared away from adrenaline stock.",
            specific_plea: "Emergency Medical specifically require high-purity Penthrite, sealed apart from Epinephrine and Atropine.",
            themes: ["trauma", "burns", "poison"], minimum_successes: 70, minimum_recipes_known: 30, exact: true, minimum_purity: 0.95, patience_scale: 2.3,
        ),
        (
            reagent: "psicodine",
            amounts: [10, 15, 20],
            plea: "Psychiatry have a patient trapped in severe hallucination, paranoia, and motor confusion after an exposure.",
            specific_plea: "Psychiatry specifically require high-purity Psicodine, free of its narcotic precursor.",
            themes: ["concussion", "poison"], minimum_successes: 50, minimum_recipes_known: 20, exact: true, minimum_purity: 0.90, patience_scale: 2.0,
        ),
        (
            reagent: "ammoniated_mercury",
            amounts: [6, 9],
            plea: "Toxicology need a clean heavy-metal purge for a rapidly deteriorating patient.",
            specific_plea: "Toxicology specifically require Ammoniated Mercury at eighty-five percent purity.",
            themes: ["poison"], minimum_successes: 35, exact: true, minimum_purity: 0.85, patience_scale: 1.75,
        ),
        (
            reagent: "neurine",
            amounts: [8, 12, 16],
            plea: "Medical need a neural repair batch for persistent sensory and motor impairment.",
            specific_plea: "Medical specifically require high-purity Neurine for persistent neural impairment.",
            themes: ["concussion"], minimum_successes: 45, exact: true, minimum_purity: 0.90, patience_scale: 2.0,
        ),
        (
            reagent: "seiver",
            amounts: [9, 12, 15],
            plea: "Containment have a combined radiation and toxin casualty who needs specialist treatment.",
            specific_plea: "Containment specifically require high-purity Seiver for a combined exposure casualty.",
            themes: ["radiation"], minimum_successes: 50, exact: true, minimum_purity: 0.90, patience_scale: 2.0,
        ),
        (
            reagent: "bicaridine",
            themes: ["trauma"],
            // Overdoses at 15u, but the recipe (chem.reactions.ron) only
            // ever yields even amounts, so 15 itself can never be made
            // exactly — a pill, bottle or syringe can only overshoot it to
            // 16 and grade Overdose. 14 is the real ceiling.
            amounts: [8, 12, 14],
            plea: "Got a crewman bleeding badly down here. Whatever stops it, quick as you can.",
            specific_plea: "Got a crewman bleeding badly down here. Bicaridine, quick as you can.",
        ),
        (
            reagent: "kelotane",
            themes: ["burns"],
            // Overdoses at 15u. Same even-only recipe as bicaridine (see
            // above), so 14 is the real ceiling — 15 cannot be made exactly.
            amounts: [10, 12, 14],
            plea: "Welder burn. Nothing dramatic. Something for it would sort him out.",
            specific_plea: "Welder burn. Nothing dramatic. Some kelotane would sort it.",
        ),
        (
            reagent: "dermaline",
            themes: ["burns"],
            // Overdoses at 10u — the tightest of the medicines, which is the
            // trade for it being the strongest burn treatment. The recipe
            // yields in multiples of 3, so 9 is as close as it gets — 10
            // itself would force an overshoot into Overdose.
            amounts: [6, 8, 9],
            plea: "Plasma fire in engineering, burns are deep. Need your best burn treatment.",
            specific_plea: "Plasma fire in engineering, burns are deep. Need dermaline — nothing weaker's touching this.",
        ),
        (
            reagent: "dylovene",
            themes: ["poison"],
            // Overdoses at 20u, but the recipe yields in multiples of 3, so
            // 20 itself can never be made exactly. 18 is the real ceiling.
            amounts: [12, 16, 18],
            plea: "Someone's been poisoned in the bar. Whatever clears it, please.",
            specific_plea: "Someone's been poisoned in the bar. Dylovene, please.",
        ),
        (
            reagent: "inaprovaline",
            // Retagged from "trauma": the reagent's real category is
            // Airloss, and "crashing" reads as breathing trouble just as
            // well — the theme should match what the order now literally
            // requires.
            themes: ["asphyxiation"],
            amounts: [30, 45],
            plea: "This one's crashing. Something to hold them steady while they breathe.",
            specific_plea: "This one's crashing. Inaprovaline to hold them steady.",
        ),
        (
            reagent: "tricordrazine",
            themes: ["trauma", "poison"],
            amounts: [30, 40],
            plea: "Bit of everything wrong with this patient. Anything that covers it all.",
            specific_plea: "Bit of everything wrong with this patient. Doctor wants Tricordrazine specifically — don't substitute.",
        ),
        (
            reagent: "dexalin",
            themes: ["asphyxiation"],
            // Overdoses at 20u.
            amounts: [12, 16, 20],
            plea: "Hull breach on deck two, we have asphyxiation cases. Anything that helps them breathe.",
            specific_plea: "Hull breach on deck two, we have asphyxiation cases. Dexalin, by name — we're not taking chances.",
        ),
        (
            reagent: "hyronalin",
            themes: ["radiation"],
            amounts: [20, 30],
            plea: "Walked past a leaking container. Mild dose. Something for it should do.",
            specific_plea: "Walked past a leaking container. Mild dose. Hyronalin should do.",
        ),
        (
            reagent: "arithrazine",
            themes: ["radiation"],
            amounts: [20, 30],
            plea: "Containment failure. This is a serious dose. Your strongest anti-rad, now.",
            specific_plea: "Containment failure. This is a serious dose. Arithrazine, now — nothing else touches it in time.",
        ),
        (
            // The one order that comes in large. Saline-glucose overdoses at
            // 60u where bicaridine does at 15, so medbay ask for a bag of it
            // rather than a dose.
            reagent: "saline_glucose",
            themes: ["trauma", "burns"],
            amounts: [40, 50],
            plea: "Two walking wounded and no beds. Send whatever you can spare, in bulk.",
            specific_plea: "Two walking wounded and no beds. Send saline-glucose, as much as you can spare.",
        ),
        (
            reagent: "potassium_iodide",
            themes: ["radiation"],
            amounts: [20, 30],
            plea: "Atmos are going into the containment bay. Something for it, before they do.",
            specific_plea: "Atmos are going into the containment bay. Potassium iodide, before they do.",
        ),
        (
            reagent: "mannitol",
            themes: ["concussion"],
            // Overdoses at 15u.
            amounts: [10, 12, 15],
            plea: "Took a baton to the head and can't hold a thought. Something should clear it.",
            specific_plea: "Took a baton to the head and can't hold a thought. Mannitol should clear it — synaptizine makes him worse.",
        ),
    ],
)
