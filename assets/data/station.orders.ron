// Order generation and the requests crew can make.
//
// `amounts` are the quantities a requester might ask for, in units. Keep them
// achievable with one or two beakers — an order nobody can physically carry is
// just a guaranteed failure.
//
// The numbers below are tier 0 — a brand new career. Everything in `ramp`
// tightens them as `succeeded + botched` climbs; `ShiftRules::for_tier` is
// where that arithmetic lives, and `tier_zero_matches_the_base_config`
// guarantees the ramp is a no-op here.
(
    first_order_delay: 8.0,
    gap_seconds: (32.0, 58.0),
    patience_seconds: (135.0, 230.0),
    max_active: 3,

    // How much rarer an "asks for it by name" order is than an ordinary
    // lenient one, multiplied onto the *current* legitimate gap above —
    // matches `station.antagonist.ron`'s own `gap_multiplier` by default, so
    // an honest specific ask happens exactly as often as an illicit one.
    specific_gap_multiplier: (6.0, 10.0),

    // How often the station briefing redraws. There is no shift boundary to
    // redraw it against any more — crew arrive continuously — so this is its
    // own clock.
    forecast_seconds: (180.0, 300.0),

    // How much harder the lab gets as the career goes on. Every value is
    // clamped: an unclamped ramp is only unplayable somewhere nobody tests.
    ramp: (
        orders_per_tier: 5,
        gap_scale: 0.92,
        gap_floor: 18.0,
        patience_scale: 0.95,
        patience_floor: 80.0,
        max_active_every: 2,
        max_active_cap: 5,
        stretch_base: 0.25,
        stretch_step: 0.02,
        stretch_cap: 0.4,
        forecast_boost: 2.0,

        // Team-size scaling, layered on top of the tier ramp above rather
        // than replacing it — see `shift::scale_for_chemists`. Solo
        // (one chemist) is a mathematical no-op by construction: these three
        // are the newest and least-playtested knobs in this file, expect to
        // re-tune them once a 3-4 person table has actually been played.
        chemist_gap_scale: 0.85,
        max_active_per_chemist: 1,
        max_active_chemist_cap: 3,
    ),

    // Cargo tops the lab up to `glassware_target` on a periodic check.
    // Beakers leave with whoever they were handed to and nothing else makes
    // them, so without this the lab runs dry after five deliveries.
    supply: (
        courier: "Miner Sato",
        glassware_target: 6,
        crate_max: 4,
        large_every: 3,
        requisition_glassware_bonus: 2,
    ),

    // What the station expects, briefed periodically over the radio. A
    // forecast leans the request pool toward its themes — it never chooses
    // for it, so a stretch you are unprepared for is still one you can work.
    forecasts: [
        (
            id: "hull_plate",
            themes: ["burns"],
            weight: 1.0,
            briefing: "Engineering are cutting hull plate all shift. Expect burns.",
        ),
        (
            id: "breach_drill",
            themes: ["asphyxiation", "trauma"],
            weight: 1.0,
            briefing: "Breach drill on deck two. Asphyxiation cases, maybe worse.",
        ),
        (
            id: "containment",
            themes: ["radiation"],
            weight: 0.8,
            briefing: "Atmos flagged a leaking containment cell. Watch for rad exposure.",
        ),
        (
            id: "bar_night",
            themes: ["poison"],
            weight: 1.0,
            briefing: "Payday, and the bar is heaving. You know how that ends.",
        ),
        (
            id: "sparring",
            themes: ["trauma"],
            weight: 0.9,
            briefing: "Security are running takedown drills. Bruises and worse.",
        ),
        (
            id: "takedown_drills",
            themes: ["concussion", "trauma"],
            weight: 0.8,
            briefing: "Security are running headgear-optional takedown drills. Expect heads to be rung.",
        ),
        (
            id: "quiet",
            themes: [],
            weight: 0.6,
            briefing: "Nothing on the board. Should be a quiet one — use it.",
        ),
    ],

    // `reagent` is still what each request is authored around — it decides
    // the category the request actually requires (see
    // `orders::reference_category`) and gates reachability. `plea` no longer
    // names it: a legitimate order now describes the problem, not the cure,
    // and accepts any chemical that treats the same category — deliver a
    // better one than whatever's implied here and it earns more department
    // favor (see `Reagent::potency`). `specific_plea` is what the same
    // request says on the rare occasions it is drawn as an exact ask instead
    // — see `orders::generate_specific_orders`.
    //
    // `amounts` must stay at or under the reagent's own `overdose` threshold
    // in `chem.reagents.ron`. Above it there is no delivery that works: a
    // pill, bottle or syringe of exactly what was asked for grades `Overdose`
    // and anything smaller grades `Short`, leaving a beaker as the only
    // container that ever passes and nothing on screen saying why. Pinned by
    // `no_request_asks_for_more_than_can_be_safely_handed_over`, and clamped
    // at spawn by `orders::deliverable_amount` for anything that slips
    // through anyway.
    requests: [
        (
            reagent: "bicaridine",
            themes: ["trauma"],
            // Overdoses at 15u, but the recipe (chem.reactions.ron) only
            // ever yields even amounts, so 15 itself can never be made
            // exactly — a pill, bottle or syringe can only overshoot it to
            // 16 and grade Overdose. 14 is the real ceiling.
            amounts: [8, 12, 14],
            plea: "Got a crewman bleeding badly down here. Whatever stops it, quick as you can.",
            specific_plea: "Got a crewman bleeding badly down here. Bicaridine, quick as you can.",
        ),
        (
            reagent: "kelotane",
            themes: ["burns"],
            // Overdoses at 15u. Same even-only recipe as bicaridine (see
            // above), so 14 is the real ceiling — 15 cannot be made exactly.
            amounts: [10, 12, 14],
            plea: "Welder burn. Nothing dramatic. Something for it would sort him out.",
            specific_plea: "Welder burn. Nothing dramatic. Some kelotane would sort it.",
        ),
        (
            reagent: "dermaline",
            themes: ["burns"],
            // Overdoses at 10u — the tightest of the medicines, which is the
            // trade for it being the strongest burn treatment. The recipe
            // yields in multiples of 3, so 9 is as close as it gets — 10
            // itself would force an overshoot into Overdose.
            amounts: [6, 8, 9],
            plea: "Plasma fire in engineering, burns are deep. Need your best burn treatment.",
            specific_plea: "Plasma fire in engineering, burns are deep. Need dermaline — nothing weaker's touching this.",
        ),
        (
            reagent: "dylovene",
            themes: ["poison"],
            // Overdoses at 20u, but the recipe yields in multiples of 3, so
            // 20 itself can never be made exactly. 18 is the real ceiling.
            amounts: [12, 16, 18],
            plea: "Someone's been poisoned in the bar. Whatever clears it, please.",
            specific_plea: "Someone's been poisoned in the bar. Dylovene, please.",
        ),
        (
            reagent: "inaprovaline",
            // Retagged from "trauma": the reagent's real category is
            // Airloss, and "crashing" reads as breathing trouble just as
            // well — the theme should match what the order now literally
            // requires.
            themes: ["asphyxiation"],
            amounts: [30, 45],
            plea: "This one's crashing. Something to hold them steady while they breathe.",
            specific_plea: "This one's crashing. Inaprovaline to hold them steady.",
        ),
        (
            reagent: "tricordrazine",
            themes: ["trauma", "poison"],
            amounts: [30, 40],
            plea: "Bit of everything wrong with this patient. Anything that covers it all.",
            specific_plea: "Bit of everything wrong with this patient. Doctor wants Tricordrazine specifically — don't substitute.",
        ),
        (
            reagent: "dexalin",
            themes: ["asphyxiation"],
            // Overdoses at 20u.
            amounts: [12, 16, 20],
            plea: "Hull breach on deck two, we have asphyxiation cases. Anything that helps them breathe.",
            specific_plea: "Hull breach on deck two, we have asphyxiation cases. Dexalin, by name — we're not taking chances.",
        ),
        (
            reagent: "hyronalin",
            themes: ["radiation"],
            amounts: [20, 30],
            plea: "Walked past a leaking container. Mild dose. Something for it should do.",
            specific_plea: "Walked past a leaking container. Mild dose. Hyronalin should do.",
        ),
        (
            reagent: "arithrazine",
            themes: ["radiation"],
            amounts: [20, 30],
            plea: "Containment failure. This is a serious dose. Your strongest anti-rad, now.",
            specific_plea: "Containment failure. This is a serious dose. Arithrazine, now — nothing else touches it in time.",
        ),
        (
            // The one order that comes in large. Saline-glucose overdoses at
            // 60u where bicaridine does at 15, so medbay ask for a bag of it
            // rather than a dose.
            reagent: "saline_glucose",
            themes: ["trauma", "burns"],
            amounts: [40, 50],
            plea: "Two walking wounded and no beds. Send whatever you can spare, in bulk.",
            specific_plea: "Two walking wounded and no beds. Send saline-glucose, as much as you can spare.",
        ),
        (
            reagent: "potassium_iodide",
            themes: ["radiation"],
            amounts: [20, 30],
            plea: "Atmos are going into the containment bay. Something for it, before they do.",
            specific_plea: "Atmos are going into the containment bay. Potassium iodide, before they do.",
        ),
        (
            reagent: "mannitol",
            themes: ["concussion"],
            // Overdoses at 15u.
            amounts: [10, 12, 15],
            plea: "Took a baton to the head and can't hold a thought. Something should clear it.",
            specific_plea: "Took a baton to the head and can't hold a thought. Mannitol should clear it — synaptizine makes him worse.",
        ),
    ],
)
