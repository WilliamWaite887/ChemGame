// Reagents. `dispensable: true` means the base chemical dispenser produces it
// directly; everything else has to be made.
//
// `overdose` is the dose above which the reagent harms rather than helps.
// `treats` shows in the reference book even while a recipe is still locked —
// a chemist knows what bicaridine is for even if they have forgotten how to
// make it.
//
// `categories` decides which heading in the book a recipe files under, and a
// reagent may name several: tricordrazine really does treat all four damage
// types. Raw materials leave it empty because they never get an entry;
// anything craftable must name at least one, which a test enforces.
//
// `effects` is what the reagent does per metabolism tick to whoever takes it,
// and `overdose_effects` stack on top of those past the threshold rather than
// replacing them: an overdose is the medicine still working while it also
// hurts you. Numbers follow /tg/station where it has an opinion.
//
// A note for editors: RON will not coerce an integer into the `f32` inside
// `boils_at`. Write `Some((323.15))`, never `Some((323))`.
[
    // ---- Base reagents: straight from the dispenser -----------------------
    //
    // Most of these do nothing at all in a body, which is canon and also
    // useful: a chemist who drinks the oxygen supply learns something cheap.
    //
    // `tier` gates the other 17 behind a dispenser upgrade
    // (`Knowledge::upgrade_dispenser`): the whole tier unlocks at once for a
    // lump research-point cost, rather than buying one reagent at a time.
    // Listed here in tier order, tier 0 (free) first. Tier 1 (24 points)
    // covers reagents that feed early, common recipes (water alone unlocks
    // hooch, hydrogen_peroxide and the saltwater chain); tiers 2-3 (27/48)
    // are more specialised or already pyro-adjacent; tiers 4-7 (15/54/21/24)
    // gate the exotic or outright dangerous end — chlorine trifluoride's
    // fluorine, and mercury, the priciest tier of all, behind the
    // illicit-adjacent mindbreaker_toxin/zombie_powder chain. Nothing here
    // changes what a fully-upgraded dispenser can eventually make — only how
    // long it takes to get there. Per-reagent costs were tripled from the
    // original 2-8 scale (M11) once a fresh career was clearing the whole
    // 71-point tree in under an hour; the tier upgrade costs below are just
    // those same per-reagent costs summed per tier, so the 213-point total to
    // fully upgrade is unchanged — only the unit of purchase moved from one
    // reagent to a whole tier.
    //
    // ---- Tier 0: free from the start ---------------------------------------
    //
    // One of the six base reagents the three starting recipes are built
    // from. See `every_starting_ingredient_is_unlocked_free`.
    (id: "carbon",     name: "Carbon",     color: (0.12, 0.12, 0.13), dispensable: true),
    (id: "nitrogen",   name: "Nitrogen",   color: (0.62, 0.70, 0.86), dispensable: true),
    (id: "oxygen",     name: "Oxygen",     color: (0.60, 0.80, 1.00), dispensable: true),
    (id: "potassium",  name: "Potassium",  color: (0.86, 0.84, 0.72), dispensable: true),
    (id: "silicon",    name: "Silicon",    color: (0.66, 0.68, 0.72), dispensable: true),
    (
        id: "sugar",
        name: "Sugar",
        color: (0.98, 0.98, 0.96),
        dispensable: true,
        // Burns off fast and takes an absurd amount to hurt you, which is the
        // joke: the safest thing in the lab still has a threshold.
        metabolism: Some(2.0),
        overdose: Some(120),
        overdose_effects: [Harm(Toxin, 2)],
    ),

    // ---- Tier 1: 24 points --------------------------------------------------
    (
        id: "hydrogen",
        name: "Hydrogen",
        color: (0.90, 0.90, 0.95),
        dispensable: true,
        tier: 1,
    ),
    (
        id: "iron",
        name: "Iron",
        color: (0.50, 0.28, 0.24),
        dispensable: true,
        tier: 1,
        // Iron restores blood in SS13, and blood loss is what oxygen damage
        // represents here.
        effects: [Heal(Oxygen, 1)],
    ),
    (
        id: "sodium",
        name: "Sodium",
        color: (0.90, 0.88, 0.82),
        dispensable: true,
        tier: 1,
    ),
    (
        id: "water",
        name: "Water",
        color: (0.55, 0.72, 0.90),
        dispensable: true,
        tier: 1,
        // The only thing in the lab that sobers you up.
        effects: [Counter(kind: Drunk, seconds: 2.0, intensity: 0.25)],
    ),

    // ---- Tier 2: 27 points --------------------------------------------------
    (
        id: "copper",
        name: "Copper",
        color: (0.72, 0.45, 0.20),
        dispensable: true,
        tier: 2,
    ),
    (
        id: "phosphorus",
        name: "Phosphorus",
        color: (0.94, 0.90, 0.66),
        dispensable: true,
        tier: 2,
    ),
    (
        id: "sulfur",
        name: "Sulfur",
        color: (0.95, 0.90, 0.35),
        dispensable: true,
        tier: 2,
        effects: [Harm(Toxin, 0.5)],
    ),

    // ---- Tier 3: 48 points --------------------------------------------------
    (
        id: "aluminium",
        name: "Aluminium",
        color: (0.75, 0.76, 0.78),
        dispensable: true,
        tier: 3,
    ),
    (
        id: "chlorine",
        name: "Chlorine",
        color: (0.82, 0.90, 0.44),
        dispensable: true,
        tier: 3,
        effects: [Harm(Brute, 1)],
    ),
    (
        id: "ethanol",
        name: "Ethanol",
        color: (0.85, 0.85, 0.80),
        dispensable: true,
        tier: 3,
        // Lingers: half the usual rate, which is what makes one drink a
        // problem for the next twenty minutes of a shift.
        metabolism: Some(0.2),
        effects: [Status(kind: Drunk, seconds: 2.0, intensity: 0.65)],
    ),
    (
        id: "iodine",
        name: "Iodine",
        color: (0.34, 0.24, 0.42),
        dispensable: true,
        tier: 3,
        effects: [Harm(Toxin, 0.5)],
    ),

    // ---- Tier 4: 15 points --------------------------------------------------
    (
        id: "plasma",
        name: "Plasma",
        color: (0.72, 0.24, 0.86),
        dispensable: true,
        tier: 4,
        // The most poisonous thing the dispenser will hand you, and it boils
        // off at 50°C — so heating a beaker to run a hot recipe can quietly
        // cost you the catalyst that recipe needed.
        boils_at: Some((323.15)),
        effects: [Harm(Toxin, 3)],
    ),

    // ---- Tier 5: 54 points --------------------------------------------------
    (
        id: "radium",
        name: "Radium",
        color: (0.44, 0.90, 0.42),
        dispensable: true,
        tier: 5,
        effects: [Harm(Toxin, 2)],
    ),
    (
        id: "lithium",
        name: "Lithium",
        color: (0.66, 0.68, 0.74),
        dispensable: true,
        tier: 5,
        effects: [Status(kind: Unsteady, seconds: 4.0, intensity: 1.0)],
    ),
    (
        id: "welding_fuel",
        name: "Welding Fuel",
        color: (0.58, 0.44, 0.18),
        dispensable: true,
        tier: 5,
        // Drinkable in the sense that a mouthful will not kill you outright.
        // It is still the worst decision available at the dispenser.
        effects: [Harm(Toxin, 1)],
    ),

    // ---- Tier 6: 21 points --------------------------------------------------
    (
        id: "fluorine",
        name: "Fluorine",
        color: (0.78, 0.92, 0.72),
        dispensable: true,
        // The priciest halogen: chlorine trifluoride is the one recipe it
        // gates, and chlorine trifluoride is the one recipe that can detonate
        // harder than phlogiston.
        tier: 6,
        effects: [Harm(Toxin, 1)],
    ),

    // ---- Tier 7: 24 points --------------------------------------------------
    (
        id: "mercury",
        name: "Mercury",
        color: (0.60, 0.62, 0.66),
        dispensable: true,
        // The most expensive tier in the game — it gates nothing legitimate
        // at all, only mindbreaker_toxin and zombie_powder, both Illicit.
        tier: 7,
        // SS13's mercury does brain damage. There is no brain pool here, so it
        // maps onto toxin plus the twitching and the blurred vision that come
        // with it — the symptoms a chemist would actually notice.
        effects: [
            Harm(Toxin, 0.5),
            Status(kind: Unsteady, seconds: 6.0, intensity: 1.5),
            Status(kind: Blurred, seconds: 6.0, intensity: 1.0),
        ],
    ),

    // ---- Grind-only: what is left of a plant once the extract is out -------
    //
    // `from_produce` marks it as a root of the recipe graph like `dispensable`
    // does, so the reachability guardrail does not read it as a dead end. It
    // has no use of its own: it is the contaminant that stops ground produce
    // being delivered without a trip through the ChemMaster.
    (id: "plant_fibre", name: "Plant Fibre", color: (0.42, 0.50, 0.32), from_produce: true),

    // ---- Medicines --------------------------------------------------------
    //
    // Each one owns a damage type, which is what the HUD's bar colours teach
    // without a word of tutorial text.
    (
        id: "inaprovaline",
        name: "Inaprovaline",
        color: (0.85, 0.85, 0.60),
        treats: Some("Asphyxiation. Stabilises the critically injured."),
        categories: [Airloss],
        // General stabiliser rather than airloss-specific, so it's the weak
        // end of the category for order-favor purposes too.
        potency: 1,
        // Weak on purpose: it is the thing you take to stop getting worse, not
        // the thing that fixes you.
        effects: [Heal(Oxygen, 0.5)],
    ),
    (
        id: "dylovene",
        name: "Dylovene",
        color: (0.42, 0.70, 0.36),
        overdose: Some(20),
        treats: Some("Poisoning and toxin damage."),
        categories: [Antitoxins],
        potency: 2,
        effects: [Heal(Toxin, 2)],
        overdose_effects: [Harm(Toxin, 1)],
    ),
    (
        id: "kelotane",
        name: "Kelotane",
        color: (0.80, 0.50, 0.20),
        overdose: Some(15),
        treats: Some("Burns."),
        categories: [Burns],
        potency: 1,
        effects: [Heal(Burn, 2)],
        overdose_effects: [Harm(Toxin, 1)],
    ),
    (
        id: "bicaridine",
        name: "Bicaridine",
        color: (0.85, 0.25, 0.25),
        overdose: Some(15),
        treats: Some("Brute force trauma."),
        categories: [Trauma],
        potency: 2,
        effects: [Heal(Brute, 2)],
        overdose_effects: [Harm(Toxin, 1)],
    ),
    (
        id: "dermaline",
        name: "Dermaline",
        color: (0.95, 0.62, 0.20),
        overdose: Some(10),
        treats: Some("Severe burns. Stronger than kelotane."),
        categories: [Burns],
        potency: 2,
        // Heals harder than kelotane and overdoses sooner. That trade is the
        // entire reason to keep both on the shelf.
        effects: [Heal(Burn, 3)],
        overdose_effects: [Harm(Toxin, 2)],
    ),
    (
        id: "tricordrazine",
        name: "Tricordrazine",
        color: (0.30, 0.75, 0.65),
        treats: Some("All basic damage types, slowly. A good all-rounder."),
        // The one reagent that earns a place under every medical heading.
        categories: [Trauma, Burns, Antitoxins, Airloss],
        // The weak end of all four categories it belongs to — versatile, not
        // potent. A department pays less favor for it than for a dedicated
        // medicine, which is the honest trade for "one bottle treats anything".
        potency: 1,
        effects: [Heal(Brute, 1), Heal(Burn, 1), Heal(Toxin, 1), Heal(Oxygen, 1)],
    ),
    (
        id: "dexalin",
        name: "Dexalin",
        color: (0.40, 0.65, 0.95),
        overdose: Some(20),
        treats: Some("Airloss and oxygen deprivation."),
        categories: [Airloss],
        potency: 2,
        effects: [Heal(Oxygen, 3)],
        overdose_effects: [Harm(Toxin, 1)],
    ),
    (
        id: "hyronalin",
        name: "Hyronalin",
        color: (0.55, 0.80, 0.40),
        overdose: Some(30),
        treats: Some("Mild radiation exposure."),
        categories: [Radiation],
        potency: 1,
        effects: [Heal(Toxin, 1), Counter(kind: Irradiated, seconds: 2.0, intensity: 1.0)],
        overdose_effects: [Harm(Toxin, 1)],
    ),
    (
        id: "arithrazine",
        name: "Arithrazine",
        color: (0.70, 0.90, 0.45),
        treats: Some("Severe radiation poisoning."),
        categories: [Radiation],
        // The strongest treatment in its category, and the hardest to make —
        // the three-step chain earns its favor bonus.
        potency: 3,
        // Strips radiation three times faster than hyronalin and takes a
        // little skin off doing it. No overdose threshold: the brute cost is
        // already the limiter.
        effects: [
            Heal(Toxin, 2),
            Counter(kind: Irradiated, seconds: 2.0, intensity: 3.0),
            Harm(Brute, 0.5),
        ],
    ),
    (
        id: "potassium_iodide",
        name: "Potassium Iodide",
        color: (0.72, 0.66, 0.86),
        overdose: Some(30),
        treats: Some("Radiation, before you get it rather than after."),
        categories: [Radiation],
        potency: 1,
        // Weaker than hyronalin at stripping a dose already taken, but it is
        // two base reagents and nothing else, so it is what you can have ready
        // in a bottle before the alarm goes off.
        effects: [Heal(Toxin, 0.5), Counter(kind: Irradiated, seconds: 2.0, intensity: 2.0)],
        overdose_effects: [Harm(Toxin, 1)],
    ),
    (
        id: "mannitol",
        name: "Mannitol",
        color: (0.86, 0.90, 0.94),
        overdose: Some(15),
        treats: Some("Concussion. Clears a rung head."),
        categories: [Stimulants],
        // The one genuinely medical member of its category.
        potency: 2,
        // Synaptizine does the same job harder and poisons you for it. This
        // does not, and overdoses at fifteen instead.
        effects: [
            Counter(kind: Blurred, seconds: 4.0, intensity: 2.0),
            Counter(kind: Unsteady, seconds: 4.0, intensity: 2.0),
        ],
        overdose_effects: [Harm(Toxin, 2)],
    ),
    (
        id: "saline_glucose",
        name: "Saline-Glucose Solution",
        color: (0.90, 0.93, 0.88),
        // Four times bicaridine's threshold. That is the whole point of it:
        // half the healing rate, but a dose you can hand over without doing
        // arithmetic first.
        overdose: Some(60),
        treats: Some("Trauma and burns together, slowly. Safe in bulk."),
        categories: [Trauma, Burns],
        potency: 1,
        effects: [Heal(Brute, 0.5), Heal(Burn, 0.5)],
        overdose_effects: [Harm(Brute, 1), Harm(Burn, 1)],
    ),

    // ---- Toxins -----------------------------------------------------------
    //
    // Nobody orders these. They exist as locked book entries, as things to
    // discover by accident, and as the reason the reaction chamber is dangerous.
    // `treats` still carries their book line — it is the entry text, whatever
    // its polarity.
    (
        id: "sulphuric_acid",
        name: "Sulphuric Acid",
        color: (0.86, 0.82, 0.30),
        treats: Some("Nothing. It dissolves things, including you."),
        categories: [Poisons],
        // The only reagent whose route really matters: a needle drives it past
        // the skin that a mouthful mostly does not.
        effects: [Harm(Toxin, 1), Contact(Burn, 2)],
    ),
    (
        id: "chloral_hydrate",
        name: "Chloral Hydrate",
        color: (0.92, 0.94, 0.88),
        overdose: Some(15),
        treats: Some("Puts people out. Past 15u it does rather more than that."),
        categories: [Stimulants],
        effects: [
            Status(kind: Sluggish, seconds: 6.0, intensity: 1.0),
            Status(kind: Blurred, seconds: 6.0, intensity: 1.0),
        ],
        overdose_effects: [Harm(Toxin, 2)],
    ),
    (
        id: "phlogiston",
        name: "Phlogiston",
        color: (0.98, 0.42, 0.18),
        treats: Some("Nothing. It burns, and it does not stop."),
        categories: [Pyrotechnics],
        effects: [Harm(Burn, 2), Contact(Burn, 6)],
    ),
    (
        id: "unstable_mutagen",
        name: "Unstable Mutagen",
        color: (0.36, 0.86, 0.30),
        treats: Some("Nothing. It rewrites you, and it is not careful about it."),
        categories: [Poisons],
        effects: [Harm(Toxin, 2), Status(kind: Irradiated, seconds: 4.0, intensity: 1.5)],
    ),
    (
        id: "cyanide",
        name: "Cyanide",
        color: (0.30, 0.34, 0.30),
        treats: Some("Nothing. It stops you breathing from the inside."),
        categories: [Poisons],
        // The only reagent in the game that does oxygen damage directly, which
        // makes dexalin the one thing that will not save you from it — the
        // debt comes back faster than dexalin clears it.
        effects: [Harm(Oxygen, 4), Harm(Toxin, 1)],
    ),

    // ---- Stimulants -------------------------------------------------------
    (
        id: "hyperzine",
        name: "Hyperzine",
        color: (0.95, 0.35, 0.62),
        overdose: Some(10),
        treats: Some("Nothing at all, but you will move like it does."),
        categories: [Stimulants],
        effects: [Status(kind: Hastened, seconds: 4.0, intensity: 1.0)],
        overdose_effects: [Harm(Toxin, 1)],
    ),
    (
        id: "synaptizine",
        name: "Synaptizine",
        color: (0.68, 0.42, 0.78),
        overdose: Some(5),
        treats: Some("Clears your head. Takes a little out of you every time."),
        categories: [Stimulants],
        // The antidote to your own bad decisions, at a price. Note the low
        // overdose threshold: five units is not much of a margin.
        effects: [
            Counter(kind: Blurred, seconds: 4.0, intensity: 2.0),
            Counter(kind: Unsteady, seconds: 4.0, intensity: 2.0),
            Harm(Toxin, 0.5),
        ],
        overdose_effects: [Harm(Toxin, 2)],
    ),

    // ---- Drink ------------------------------------------------------------
    (
        id: "hooch",
        name: "Hooch",
        color: (0.62, 0.42, 0.20),
        overdose: Some(30),
        treats: Some("Nothing good. Cheap, nasty, and strong."),
        categories: [Utility],
        effects: [Status(kind: Drunk, seconds: 4.0, intensity: 1.6), Harm(Toxin, 0.3)],
        overdose_effects: [Harm(Toxin, 1)],
    ),

    // ---- Precursors -------------------------------------------------------
    //
    // The industrial tier: nothing here is worth making for its own sake, and
    // three of them are the only use the dispenser's duller reagents have ever
    // had. Sodium, aluminium and welding fuel were dead content before this.
    (
        id: "ammonia",
        name: "Ammonia",
        color: (0.72, 0.86, 0.78),
        treats: Some("Nothing. A fertiliser, and the way in to three other recipes."),
        categories: [Precursors],
        effects: [Harm(Toxin, 1)],
    ),
    (
        id: "sodium_chloride",
        name: "Table Salt",
        color: (0.96, 0.96, 0.94),
        treats: Some("Nothing. Salt. The first thing sodium has ever been good for."),
        categories: [Precursors],
    ),
    (
        id: "saltwater",
        name: "Saltwater",
        color: (0.68, 0.80, 0.90),
        treats: Some("Nothing on its own. Half of a saline drip."),
        categories: [Precursors],
    ),
    (
        id: "ice",
        name: "Ice",
        color: (0.80, 0.92, 0.98),
        treats: Some("Nothing. Water that had a hard time. Keeps its cool."),
        categories: [Precursors],
        effects: [Status(kind: Sluggish, seconds: 3.0, intensity: 0.8)],
    ),
    (
        id: "stabilizing_agent",
        name: "Stabilizing Agent",
        color: (0.62, 0.64, 0.60),
        treats: Some("Nothing. Present at a reaction, it stops the reaction going off."),
        categories: [Precursors],
    ),
    (
        id: "oil",
        name: "Oil",
        color: (0.20, 0.18, 0.16),
        treats: Some("Nothing. Flammable, and the base of two worse things."),
        categories: [Precursors],
        effects: [Harm(Toxin, 0.5)],
    ),
    (
        id: "hydrogen_peroxide",
        name: "Hydrogen Peroxide",
        color: (0.88, 0.94, 0.98),
        treats: Some("Nothing. It bleaches whatever it lands on, skin included."),
        // Files under both: it is a precursor by intent and corrosive by
        // accident, and a chemist looking under either heading should find it.
        categories: [Poisons, Precursors],
        effects: [Harm(Toxin, 0.5), Contact(Burn, 2)],
    ),

    // ---- Pyrotechnics -----------------------------------------------------
    //
    // Nothing here treats anything. They exist because a chemist who has never
    // set the lab on fire has not finished learning the job.
    (
        id: "thermite",
        name: "Thermite",
        color: (0.52, 0.36, 0.22),
        treats: Some("Nothing. It burns through a bulkhead, and through you."),
        categories: [Pyrotechnics],
        effects: [Harm(Burn, 2), Contact(Burn, 3)],
    ),
    (
        id: "flash_powder",
        name: "Flash Powder",
        color: (0.94, 0.94, 0.86),
        treats: Some("Nothing. A bright, blinding nuisance."),
        categories: [Pyrotechnics],
        effects: [Status(kind: Blurred, seconds: 6.0, intensity: 2.0), Contact(Burn, 1)],
    ),
    (
        id: "smoke",
        name: "Smoke",
        color: (0.60, 0.60, 0.62),
        treats: Some("Nothing. It fills the room the instant it is made."),
        categories: [Pyrotechnics],
        effects: [Harm(Toxin, 0.5), Status(kind: Blurred, seconds: 4.0, intensity: 1.0)],
    ),
    (
        id: "smoke_powder",
        name: "Smoke Powder",
        color: (0.72, 0.70, 0.66),
        treats: Some("Nothing. The same cloud, held in the beaker until you want it."),
        categories: [Pyrotechnics],
        effects: [Harm(Toxin, 0.3), Status(kind: Blurred, seconds: 2.0, intensity: 0.5)],
    ),
    (
        id: "chlorine_trifluoride",
        name: "Chlorine Trifluoride",
        color: (0.94, 0.78, 0.30),
        treats: Some("Nothing. It sets fire to things that have already burned."),
        categories: [Pyrotechnics, Poisons],
        // Metabolises out ten times faster than anything else, which is the
        // only reason a dose is survivable at all.
        metabolism: Some(4.0),
        effects: [Harm(Burn, 6), Contact(Burn, 8)],
    ),
    (
        id: "cryostylane",
        name: "Cryostylane",
        color: (0.62, 0.86, 0.96),
        treats: Some("Nothing. Cold enough to slow a body down and keep it that way."),
        categories: [Pyrotechnics],
        effects: [Status(kind: Sluggish, seconds: 6.0, intensity: 2.0), Harm(Brute, 0.5)],
    ),
    (
        id: "napalm",
        name: "Napalm",
        color: (0.68, 0.30, 0.12),
        treats: Some("Nothing. It burns slowly, and it sticks."),
        categories: [Pyrotechnics],
        effects: [Harm(Burn, 1), Contact(Burn, 4)],
    ),

    // ---- Utility ----------------------------------------------------------
    (
        id: "space_cleaner",
        name: "Space Cleaner",
        color: (0.56, 0.82, 0.76),
        treats: Some("Nothing. The janitor will thank you. Do not drink it."),
        categories: [Utility],
        effects: [Harm(Toxin, 1)],
    ),

    // ---- Illicit ------------------------------------------------------
    //
    // Nobody on `station.orders.ron` ever asks for these — only the hidden
    // antagonist pool in `station.antagonist.ron` does. Discoverable the same
    // way Poisons are: mix into one by accident at the test bench, or deduce
    // it from hints.
    (
        id: "space_drugs",
        name: "Space Drugs",
        color: (0.72, 0.30, 0.86),
        overdose: Some(20),
        treats: Some("Nothing anyone orders. A euphoric with a nasty comedown."),
        categories: [Illicit],
        effects: [Status(kind: Drunk, seconds: 6.0, intensity: 1.8)],
        overdose_effects: [Harm(Toxin, 2), Status(kind: Unsteady, seconds: 4.0, intensity: 1.5)],
    ),
    (
        id: "bath_salts",
        name: "Bath Salts",
        color: (0.90, 0.42, 0.58),
        overdose: Some(15),
        treats: Some("Nothing. A jittery, paranoid stimulant."),
