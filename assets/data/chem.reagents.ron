    // ---- Illicit ------------------------------------------------------
    //
    // Nobody on `station.orders.ron` ever asks for these — only the hidden
    // antagonist pool in `station.antagonist.ron` does. Discoverable the same
    // way Poisons are: mix into one by accident at the test bench, or deduce
    // it from hints.
    (
        // `addictive` (see `src/addiction`): how readily repeated doses build
        // a habit in whoever takes them. The whole Illicit shelf carries one,
        // because a repeat customer is the only reason to deal at all — and
        // an addict who is visibly high while Security is in the room is the
        // price. Zero, and absent, for everything else.
        id: "space_drugs",
        addictive: 1.0,
        name: "Space Drugs",
        color: (0.72, 0.30, 0.86),
        overdose: Some(20),
        treats: Some("Nothing anyone orders. A euphoric with a nasty comedown."),
        categories: [Illicit],
        effects: [
            Status(kind: Euphoric, seconds: 8.0, intensity: 2.0),
            Status(kind: Hallucinating, seconds: 6.0, intensity: 1.2),
        ],
        overdose_effects: [
            Harm(Toxin, 2),
            Status(kind: Unsteady, seconds: 4.0, intensity: 1.5),
        ],
        after_effects: [
            Status(kind: Sluggish, seconds: 14.0, intensity: 1.2),
            Status(kind: Unsteady, seconds: 8.0, intensity: 0.8),
        ],
    ),
