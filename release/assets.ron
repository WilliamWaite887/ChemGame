// This is the release boundary. A rule only includes files with the listed
// runtime extension; Python, Blender, Markdown, JSON, SVG and preview sources
// therefore never enter a Steam depot.
(
    packs: [
        (
            file: "content_00.cgp",
            include: [
                (root: "data", extensions: ["ron"]),
                (root: "maps", extensions: ["map"]),
            ],
        ),
        (
            file: "content_01.cgp",
            include: [
                // Shared gameplay assets for the trailer also ship here:
                // chem_actions.glb, chem_beaker.glb, chem_large_beaker.glb,
                // chem_bottle.glb, chem_syringe.glb and chem_charge.glb.
                (root: "3dassets/glb", extensions: ["glb"]),
                // Includes all 36 department/shared-space expansion deliverables
                // (25 additions, 11 replacements), with materials embedded.
                (root: "3dassets/station_starter_kit/glb", extensions: ["glb"]),
            ],
        ),
        (
            file: "content_02.cgp",
            include: [
                // Includes ceiling_casing.png and ceiling_metal.png. Runtime
                // copies are protected; kit authoring originals stay ignored.
                (root: "textures", extensions: ["png"]),
                (root: "ui/chemistry_book/icons", extensions: ["png"]),
            ],
        ),
    ],

    // Every credited asset stays in its original, readable form. CREDITS.md is
    // copied separately to the install root by the packer.
    public: [
        (root: "sounds", extensions: ["ogg"]),
    ],

    // These have runtime-looking extensions but are authoring output or
    // deliberately unused alternatives. Keeping them explicit makes a newly
    // added PNG/GLB fail the packaging audit until its intent is reviewed.
    ignored: [
        (root: "3dassets/previews", extensions: ["png"]),
        (root: "3dassets/station_starter_kit/textures", extensions: ["png"]),
    ],
    ignored_files: [
        // These two are compiled into the executable with include_str! and do
        // not need a second copy in a depot pack.
        "data/lab.textbook.ron",
        "data/lab.training.ron",
        "3dassets/glb/first_char_test.glb",
        "3dassets/station_starter_kit/glb/department_cargo_starter.glb",
        "3dassets/station_starter_kit/glb/department_engineering_starter.glb",
        "3dassets/station_starter_kit/glb/department_medical_starter.glb",
        "3dassets/station_starter_kit/glb/department_security_starter.glb",
        "3dassets/station_starter_kit/glb/department_service_starter.glb",
        "3dassets/station_starter_kit/preview_botany_decor.png",
        "3dassets/station_starter_kit/preview_bridge_decor.png",
        "3dassets/station_starter_kit/preview_chemistry_decor.png",
        "3dassets/station_starter_kit/preview_chemistry_fixtures.png",
        "3dassets/station_starter_kit/preview_conveyor.png",
        "3dassets/station_starter_kit/preview_cult_campaign.png",
        "3dassets/station_starter_kit/preview_department_decor.png",
        "3dassets/station_starter_kit/preview_departments.png",
        "3dassets/station_starter_kit/preview_engineering_decor.png",
        "3dassets/station_starter_kit/preview_expansion_shared.png",
        "3dassets/station_starter_kit/preview_expansion_security.png",
        "3dassets/station_starter_kit/preview_expansion_medical.png",
        "3dassets/station_starter_kit/preview_expansion_engineering.png",
        "3dassets/station_starter_kit/preview_machines.png",
        "3dassets/station_starter_kit/preview_medical_decor.png",
        "3dassets/station_starter_kit/preview_medical_ward.png",
        "3dassets/station_starter_kit/preview_security_decor.png",
        "3dassets/station_starter_kit/preview_service_decor.png",
        // Editable chemistry asset sources and preview output. The exported
        // GLBs above are protected; these authoring files never ship loose.
        "3dassets/chemistry_props.blend",
        "3dassets/chemistry_actions.blend",
        "3dassets/build_chemistry_props.py",
        "3dassets/build_chemistry_actions.py",
        "3dassets/preview_chemistry_actions.py",
        "3dassets/previews/chemistry_props/lineup.png",
        "3dassets/previews/chemistry_actions/Stagger.png",
        "3dassets/previews/chemistry_actions/Pour.png",
        "3dassets/previews/chemistry_actions/CultAttack.png",
        "3dassets/previews/chemistry_actions/Apply.png",
        "textures/clip.png",
        "textures/floor_cargo.png",
        "textures/floor_engineering.png",
        "textures/floor_medical.png",
        "textures/floor_pod.png",
        "textures/floor_security.png",
        "textures/floor_service.png",
        "textures/preview_chemistry_surfaces.png",
    ],
)
